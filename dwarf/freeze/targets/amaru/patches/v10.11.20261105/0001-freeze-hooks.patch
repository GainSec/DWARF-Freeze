+    /// A ledger store at slot 42 holding three outputs, two of them staked by the same key.
+    fn ledger_of_three_outputs()
+    -> (tempfile::TempDir, RocksDbConfig, RocksDB, Vec<TransactionInput>, [MemoizedTransactionOutput; 3]) {
+        let dir = tempfile::tempdir().unwrap();
+        let config = RocksDbConfig::new(dir.path().to_path_buf());
+        // A ledger store is only opened once it has a snapshot next to it.
+        std::fs::File::create(dir.path().join("0")).unwrap();
+        let node = RocksDB::empty(&config).unwrap();
+
+        let tip = Point::Specific(Slot::from(42), [9u8; 32].into(), BlockHeight::from(7));
+        let inputs: Vec<TransactionInput> = [([2u8; 32], 0), ([2u8; 32], 300), ([3u8; 32], 1)]
+            .into_iter()
+            .map(|(id, index)| TransactionInput { transaction_id: id.into(), index })
+            .collect();
+        let outputs = [output(Some([5u8; 28]), 1_000), output(Some([5u8; 28]), 234), output(None, 50)];
+        {
+            let transaction = node.create_transaction();
+            transaction
+                .save(
+                    &PREPROD_ERA_HISTORY,
+                    &PREPROD_DEFAULT_PROTOCOL_PARAMETERS,
+                    Some(GovernanceActivity::default()),
+                    &tip,
+                    None,
+                    Columns {
+                        utxo: inputs.iter().copied().zip(outputs.iter().cloned()),
+                        pools: std::iter::empty(),
+                        accounts: std::iter::empty(),
+                        dreps: std::iter::empty(),
+                        cc_members: std::iter::empty(),
+                        proposals: std::iter::empty(),
+                        votes: std::iter::empty(),
+                    },
+                    Columns::empty(),
+                    std::iter::empty(),
+                )
+                .unwrap();
+            transaction.set_protocol_parameters(&PREPROD_DEFAULT_PROTOCOL_PARAMETERS).unwrap();
+            transaction
+                .with_pots(|mut pots| {
+                    let pots = pots.borrow_mut();
+                    pots.treasury = 11;
+                    pots.reserves = 22;
+                })
+                .unwrap();
+            transaction.commit().unwrap();
+        }
+        (dir, config, node, inputs, outputs)
+    }
