+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum RepairProtocol {
+    ChainSync,
+    BlockFetch,
+}
+
+/// Decide whether an edited protocol message must enter a proven typed repair chain.
+/// Unchanged bytes need no repair; deliberate stale bytes are handled before this boundary.
+fn repair_boundary(
+    agent: &amaru_freeze::Agent,
+    protocol: &str,
+    original: &[u8],
+    candidate: &[u8],
+) -> Result<Option<RepairProtocol>, ResignError> {
+    if original == candidate {
+        return Ok(None);
+    }
+    if let Some(error) = edit_refusal(protocol, original, candidate) {
+        return Err(error);
+    }
+    let status = agent.resigning_status();
+    if !status.get("available").and_then(serde_json::Value::as_bool).unwrap_or(false) {
+        return Err(ResignError::new(
+            "controlled_devnet_signing_unavailable: edited protocol bytes require a controlled-devnet repair chain or explicit stale-negative-control authorization",
+        ));
+    }
+    if !agent.resigning_enabled() {
+        return Err(ResignError::new(
+            "controlled_devnet_signing_disabled: edited protocol bytes require enabled controlled-devnet repair or explicit stale-negative-control authorization",
+        ));
+    }
+    match protocol_number(protocol) {
+        Some(2) => Ok(Some(RepairProtocol::ChainSync)),
+        Some(3) => Ok(Some(RepairProtocol::BlockFetch)),
+        _ => Err(ResignError::new(format!(
+            "protocol_dependency_graph_unavailable: protocol {protocol} has no proven typed repair chain; use explicit stale-negative-control authorization for an invalid negative control"
+        ))),
+    }
+}
+
+fn note_refusal(agent: &amaru_freeze::Agent, seq: u64, to: String, id: &str, error: &ResignError) {
+    agent.note(Draft {
+        kind: "resign_error",
+        from: "freeze:resigner".to_string(),
+        to,
+        type_name: "freeze/resigning".to_string(),
+        label: "edited protocol message refused".to_string(),
+        payload: serde_json::json!({ "code": error.code(), "error": error.to_string() }),
+        parent: Some(seq),
+        cause: Some(seq),
+        ..Draft::default()
+    });
+    tracing::warn!(%error, protocol = %id, "Freeze refused edited bytes at the Rust repair boundary");
+}
+
+/// BlockFetch is implemented by a custom typed driver and therefore does not pass through
+/// `proto_out`. Keep the point rewrite at its real request boundary while sharing the exact same
+/// coordinator populated by edited ChainSync headers.
+pub(crate) fn blockfetch_request(from: NetworkPoint, through: NetworkPoint) -> BlockFetchRequest {
+    let Some(agent) = amaru_freeze::agent() else {
+        return BlockFetchRequest::new(from, through, from, through);
+    };
+    if !agent.resigning_enabled() {
+        return BlockFetchRequest::new(from, through, from, through);
+    }
+    RESIGNING.blockfetch_request(from, through)
+}
+
+pub(crate) fn responder_blockfetch_request(mux: &Name, from: NetworkPoint, through: NetworkPoint) -> BlockFetchRequest {
+    let Some(agent) = amaru_freeze::agent() else {
+        return BlockFetchRequest::new(from, through, from, through);
+    };
+    if !agent.resigning_enabled() {
+        return BlockFetchRequest::new(from, through, from, through);
+    }
+    RESIGNING.responder_blockfetch_request(mux.as_ref(), from, through)
+}
+
+pub(crate) fn finish_blockfetch_request(request: &BlockFetchRequest) {
+    RESIGNING.finish_blockfetch_request(request);
+}
+
+/// Remember the peer behind a multiplexer stage.
+pub(crate) fn note_peer(mux: &Name, peer: &Peer) {
+    if amaru_freeze::agent().is_some() {
+        RESIGNING.disconnect(mux.as_ref());
+        PEERS.lock().insert(mux.to_string(), format!("peer:{peer}"));
+    }
+}
+
+pub(crate) fn forget_peer(mux: &Name) {
+    PEERS.lock().remove(&mux.to_string());
+    RESIGNING.disconnect(mux.as_ref());
+}
+
+async fn gate(
+    kind: &'static str,
+    proto_id: ProtocolId<Erased>,
+    stage: &str,
+    mux: &str,
+    blockfetch_request: Option<BlockFetchRequest>,
+    message: NonEmptyBytes,
+) -> Option<NonEmptyBytes> {
+    let Some(agent) = amaru_freeze::agent() else {
+        return Some(message);
+    };
+    let id = proto_id.to_string();
+    // The stage is in the middle of handling an input; this message belongs to that chain.
+    let (input, cause) = amaru_freeze::trace::context(stage);
+    let part = stage.to_string();
+    let stage = format!("stage:{stage}");
+    let peer = PEERS.lock().get(mux).cloned().unwrap_or_else(|| "peer".to_string());
+    let (from, to) = if kind == "proto_in" { (peer.clone(), stage) } else { (stage, peer.clone()) };
+    let item = BytesItem {
+        kind,
+        from: from.clone(),
+        to: to.clone(),
+        label: protocol_name(&id).to_string(),
+        type_name: format!("ouroboros/{id}"),
+        cold_spots: if kind == "proto_in" { vec!["cbor-decode"] } else { Vec::new() },
+        bytes: &message[..],
+        is_cbor: true,
+        parent: input,
+        // A message from a peer starts a chain: everything the node does with it names it.
+        cause: if kind == "proto_in" { 0 } else { cause },
+    };
+    let (seq, verdict) = gate_bytes(agent, item).await;
+    if kind == "proto_in" {
+        amaru_freeze::trace::set_context(&part, input, seq);
+    }
+    let original = message.clone();
+    let (candidate, stale_negative_control) = match verdict {
+        BytesVerdict::Forward => (message, false),
+        BytesVerdict::Drop => return None,
+        BytesVerdict::Replace(bytes) => (NonEmptyBytes::from_slice(&bytes).ok()?, false),
+        BytesVerdict::ReplaceStale(bytes) => (NonEmptyBytes::from_slice(&bytes).ok()?, true),
+    };
+    if stale_negative_control {
+        return Some(candidate);
+    }
+    let repair_protocol = match repair_boundary(agent, &id, &original, &candidate) {
+        Ok(None) => return Some(candidate),
+        Ok(Some(protocol)) => protocol,
+        Err(error) => {
+            note_refusal(agent, seq, to, &id, &error);
+            return None;
+        }
+    };
+
+    let config = std::env::var("DWARF_FREEZE_DEVNET_CONFIG").ok().filter(|path| !path.is_empty()).map(Into::into);
+    let resigner = Resigner::new(true, config);
+    let processed = match (kind, repair_protocol) {
+        // ChainSync ancestry is scoped to its mux stream. BlockFetch point mappings are global
+        // because the scheduler may fetch the original block from any producer that has it.
+        // A reconnect may replay the original branch and must not inherit an old stream's rewrites.
+        ("proto_in", RepairProtocol::ChainSync) => {
+            RESIGNING.chain_sync(&resigner, ChainSyncDirection::Inbound, mux, &peer, &original, &candidate)
+        }
+        ("proto_out", RepairProtocol::ChainSync) => {
+            RESIGNING.chain_sync(&resigner, ChainSyncDirection::Outbound, mux, &peer, &original, &candidate)
+        }
+        ("proto_out", RepairProtocol::BlockFetch) => match blockfetch_request {
+            Some(request) => RESIGNING.blockfetch_out_for_range(mux, request, &original, &candidate),
+            None => RESIGNING.blockfetch_out(&peer, &original, &candidate),
+        },
+        ("proto_in", RepairProtocol::BlockFetch) => match blockfetch_request {
+            Some(request) => RESIGNING.blockfetch_in_for_range(&peer, request, &original, &candidate),
+            None => RESIGNING.blockfetch_in(&peer, &original, &candidate),
+        },
+        _ => unreachable!("repair_boundary admits only protocols with a typed repair chain"),
+    };
+    match processed {
+        Ok(bytes) => NonEmptyBytes::from_slice(&bytes).ok(),
+        Err(error) => {
+            agent.note(Draft {
+                kind: "resign_error",
+                from: "freeze:resigner".to_string(),
+                to,
+                type_name: "freeze/resigning".to_string(),
+                label: "edited header re-signing failed".to_string(),
+                payload: serde_json::json!({ "code": error.code(), "error": error.to_string() }),
+                parent: Some(seq),
+                cause: Some(seq),
+                ..Draft::default()
+            });
+            tracing::warn!(%error, protocol = %id, %mux, "Freeze dropped an edited message that could not be re-signed consistently");
+            None
+        }
+    }
+}
+
+/// Holding a message means waiting, and a stage may only wait on its own effects. So the
+/// offer to the agent is itself an effect, run by the runtime on the stage's behalf.
+#[derive(Debug, PartialEq, serde::Serialize, serde::Deserialize)]
+pub struct FreezeProtoEffect {
+    inbound: bool,
+    proto_id: ProtocolId<Erased>,
+    stage: String,
+    mux: String,
+    blockfetch_request: Option<BlockFetchRequest>,
+    message: NonEmptyBytes,
+}
+
+impl ExternalEffectAPI for FreezeProtoEffect {
+    type Response = Option<NonEmptyBytes>;
+    const SIMULATED_DURATION: DurationDist = DurationDist::UntilResolved;
+
+    fn run(self: Box<Self>, _resources: Resources) -> BoxFuture<'static, Box<dyn SendData>> {
+        self.wrap(|this| async move {
+            let kind = if this.inbound { "proto_in" } else { "proto_out" };
+            gate(kind, this.proto_id, &this.stage, &this.mux, this.blockfetch_request, this.message).await
+        })
+    }
+}
+
+/// A message from a peer, complete but not yet decoded. `None` means it was dropped.
+pub(crate) fn proto_in<M>(
+    proto_id: ProtocolId<Erased>,
+    eff: &Effects<M>,
+    mux: &Name,
+    message: NonEmptyBytes,
+) -> BoxFuture<'static, Option<NonEmptyBytes>> {
+    if amaru_freeze::agent().is_none() {
+        return Box::pin(std::future::ready(Some(message)));
+    }
+    let (stage, mux) = (eff.stage_name().to_string(), mux.to_string());
+    eff.external(FreezeProtoEffect { inbound: true, proto_id, stage, mux, blockfetch_request: None, message })
+}
+
+/// A BlockFetch response paired with the exact edited range consensus requested before the
+/// coordinator translated that range back to producer points.
+pub(crate) fn proto_in_blockfetch<M>(
+    proto_id: ProtocolId<Erased>,
+    eff: &Effects<M>,
+    mux: &Name,
+    blockfetch_request: BlockFetchRequest,
+    message: NonEmptyBytes,
+) -> BoxFuture<'static, Option<NonEmptyBytes>> {
+    if amaru_freeze::agent().is_none() {
+        return Box::pin(std::future::ready(Some(message)));
+    }
+    let (stage, mux) = (eff.stage_name().to_string(), mux.to_string());
+    eff.external(FreezeProtoEffect {
+        inbound: true,
+        proto_id,
+        stage,
+        mux,
+        blockfetch_request: Some(blockfetch_request),
+        message,
+    })
+}
+
+/// A message for a peer, encoded but not yet handed to the multiplexer. `None` means it was dropped.
+pub(crate) fn proto_out<M>(
+    proto_id: ProtocolId<Erased>,
+    eff: &Effects<M>,
+    mux: &Name,
+    message: NonEmptyBytes,
+) -> BoxFuture<'static, Option<NonEmptyBytes>> {
+    if amaru_freeze::agent().is_none() {
+        return Box::pin(std::future::ready(Some(message)));
+    }
+    let (stage, mux) = (eff.stage_name().to_string(), mux.to_string());
+    eff.external(FreezeProtoEffect { inbound: false, proto_id, stage, mux, blockfetch_request: None, message })
+}
+
+pub(crate) fn proto_out_blockfetch<M>(
+    proto_id: ProtocolId<Erased>,
+    eff: &Effects<M>,
+    mux: &Name,
+    blockfetch_request: BlockFetchRequest,
+    message: NonEmptyBytes,
+) -> BoxFuture<'static, Option<NonEmptyBytes>> {
+    if amaru_freeze::agent().is_none() {
+        return Box::pin(std::future::ready(Some(message)));
+    }
+    let (stage, mux) = (eff.stage_name().to_string(), mux.to_string());
+    eff.external(FreezeProtoEffect {
+        inbound: false,
+        proto_id,
+        stage,
+        mux,
+        blockfetch_request: Some(blockfetch_request),
+        message,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use amaru_freeze::Agent;
+    use serde_json::json;
+
+    use super::{RepairProtocol, edit_refusal, protocol_name, repair_boundary};
+
+    #[test]
+    fn txsubmission_edits_have_an_exact_refusal_code() {
+        let error = edit_refusal("4", b"original", b"edited").unwrap();
+        assert_eq!(
+            error.to_string(),
+            "tx_witness_material_unavailable: TxSubmission edits require an exact signer ownership map and mounted payment witness keys"
+        );
+        assert!(edit_refusal("4", b"same", b"same").is_none());
+        assert!(edit_refusal("2", b"original", b"edited").is_none());
+    }
+
+    #[test]
+    fn public_and_disabled_agents_refuse_raw_protocol_edits_at_the_rust_boundary() {
+        let public = Agent::new(json!({ "network": "public" }), None, false);
+        let unavailable = repair_boundary(&public, "2", b"original", b"edited").unwrap_err();
+        assert_eq!(unavailable.code(), Some("controlled_devnet_signing_unavailable"));
+        let unavailable_alias = repair_boundary(&public, "32770", b"original", b"edited").unwrap_err();
+        assert_eq!(unavailable_alias.code(), Some("controlled_devnet_signing_unavailable"));
+
+        let disabled = Agent::new(json!({ "network": "devnet" }), None, false);
+        disabled.configure_resigning(true, false, None);
+        let disabled_error = repair_boundary(&disabled, "3", b"original", b"edited").unwrap_err();
+        assert_eq!(disabled_error.code(), Some("controlled_devnet_signing_disabled"));
+        let disabled_alias = repair_boundary(&disabled, "32771", b"original", b"edited").unwrap_err();
+        assert_eq!(disabled_alias.code(), Some("controlled_devnet_signing_disabled"));
+    }
+
+    #[test]
+    fn enabled_repair_only_admits_protocols_with_a_typed_repair_chain() {
+        let agent = Agent::new(json!({ "network": "devnet" }), None, false);
+        agent.configure_resigning(true, true, None);
+        assert_eq!(repair_boundary(&agent, "2", b"original", b"edited").unwrap(), Some(RepairProtocol::ChainSync));
+        assert_eq!(repair_boundary(&agent, "3", b"original", b"edited").unwrap(), Some(RepairProtocol::BlockFetch));
+        assert_eq!(repair_boundary(&agent, "32770", b"original", b"edited").unwrap(), Some(RepairProtocol::ChainSync));
+        assert_eq!(repair_boundary(&agent, "32771", b"original", b"edited").unwrap(), Some(RepairProtocol::BlockFetch));
+        assert_eq!(protocol_name("32770"), "chain sync");
+        assert_eq!(protocol_name("32771"), "block fetch");
+        assert_eq!(repair_boundary(&agent, "8", b"same", b"same").unwrap(), None);
+        assert_eq!(
+            repair_boundary(&agent, "8", b"original", b"edited").unwrap_err().code(),
+            Some("protocol_dependency_graph_unavailable")
+        );
+    }
+}
