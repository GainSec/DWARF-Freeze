+fn write_envelope(path: &Path, kind: &str, raw: &[u8]) {
+    let mut cbor = Vec::new();
+    minicbor::Encoder::new(&mut cbor).bytes(raw).unwrap();
+    fs::write(
+        path,
+        serde_json::to_vec_pretty(&json!({ "type": kind, "description": "test", "cborHex": hex::encode(cbor) }))
+            .unwrap(),
+    )
+    .unwrap();
+}
+
+fn write_opcert(path: &Path, cert: &OperationalCert, issuer: &[u8; 32]) {
+    let mut cbor = Vec::new();
+    let mut encoder = minicbor::Encoder::new(&mut cbor);
+    encoder
+        .array(2)
+        .unwrap()
+        .array(4)
+        .unwrap()
+        .bytes(cert.operational_cert_kes_verification_key.as_slice())
+        .unwrap()
+        .u64(cert.operational_cert_sequence_number)
+        .unwrap()
+        .u64(cert.operational_cert_kes_period.into())
+        .unwrap()
+        .bytes(cert.operational_cert_sigma.as_slice())
+        .unwrap()
+        .bytes(issuer)
+        .unwrap();
+    fs::write(
+        path,
+        serde_json::to_vec_pretty(
+            &json!({ "type": "NodeOperationalCertificate", "description": "test", "cborHex": hex::encode(cbor) }),
+        )
+        .unwrap(),
+    )
+    .unwrap();
+}
