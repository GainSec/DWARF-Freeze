+        assert_eq!(keys(&list(&agent, "ledger/utxo", Some(&expected[1]), 10)), expected[2..]);
+        assert_eq!(list(&agent, "ledger/utxo", Some(&expected[2]), 10), Vec::<Json>::new());
+        assert_eq!(keys(&list(&agent, &format!("ledger/utxo/{}", "03".repeat(32)), None, 10)), expected[2..]);
+        assert_eq!(get(&agent, &format!("ledger/utxo/{}", expected[1])), Some(cbor_json(&outputs[1])));
