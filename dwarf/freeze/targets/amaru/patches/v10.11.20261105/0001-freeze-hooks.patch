+        agent.freeze();
+        let fork = make_header(6, 55, Some(blocks[3].header.hash()));
+        let key = chain_key(&fork.point());
+        let value = json!({ "header": cbor_json(&fork), "valid": false });
+
+        put(&agent, &format!("chain/headers/{key}"), &value).unwrap();
+        let stored = get(&agent, &format!("chain/headers/{key}")).unwrap();
+        assert_eq!(stored["header"], value["header"]);
