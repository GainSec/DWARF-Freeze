 }

+/// With a debugger attached, each header check reports its outcome through a probe of its own.
+#[test]
+fn header_checks_report_their_outcome_to_an_attached_debugger() {
+    let agent = amaru_freeze::Agent::new(serde_json::json!({}), None, false);
+    assert!(amaru_freeze::install(agent.clone()));
+    assert_eq!(agent.probes().set("consensus.validate_header.*", true), 4);
+    let reports_about = |header: &Header| -> Vec<serde_json::Value> {
+        let hash = header.hash().to_string();
+        (1..=agent.status()["seq"].as_u64().unwrap())
+            .filter_map(|seq| agent.item(seq))
+            .filter(|item| item["kind"] == "probe" && item["payload"]["hash"] == hash.as_str())
+            .collect()
+    };
+
+    let file = File::open("tests/data/header-test-cases.json").unwrap();
+    let mut cases: Vec<HeaderTestCase> = serde_json::from_reader(BufReader::new(file)).expect("decode test cases");
+    let era_history = NetworkName::Preprod.as_era_history().expect("era");
+    let (mut passed, mut failed) = (false, false);
+    for case in cases.iter_mut() {
+        let Ok(header) = case.header.get_header() else {
+            continue;
+        };
+        let slot = header.slot();
+        let epoch = era_history.slot_to_epoch_unchecked_horizon(slot).ok();
+        let Some(target) = epoch.and_then(|epoch| epoch.checked_sub(Epoch::TWO)) else {
+            continue;
+        };
+        let summaries = pool_summaries(&case.context, &case.ledger_state, header.pool_id(), target);
+        let result = validate_header(&case.context, &header, &summaries, era_history, slot);
+        let reports = reports_about(&header);
+        match (&case.expected, result) {
+            (Expected::Pass, Ok(())) if !passed => {
+                let mut checks: Vec<&str> = reports.iter().map(|report| report["label"].as_str().unwrap()).collect();
+                checks.sort();
+                checks.dedup();
+                assert_eq!(
+                    checks,
+                    [
+                        "consensus.validate_header.kes",
+                        "consensus.validate_header.leader_stake",
+                        "consensus.validate_header.opcert",
+                        "consensus.validate_header.vrf",
+                    ]
+                );
+                for report in &reports {
+                    assert_eq!(report["from"], format!("probe:{}", report["label"].as_str().unwrap()));
+                    assert_eq!(report["to"], "");
+                    assert_eq!(report["type"], "crates/amaru-ouroboros/src/praos/header.rs::assert_all");
+                    assert_eq!(report["held"], false);
+                    let outcome = serde_json::json!({
+                        "slot": u64::from(slot), "hash": header.hash().to_string(), "ok": true, "error": null,
+                    });
+                    assert_eq!(report["payload"], outcome);
+                }
+                passed = true;
+            }
+            (Expected::Error(_), Err(_)) if !failed => {
+                if let Some(report) = reports.iter().find(|report| report["payload"]["ok"] == false) {
+                    assert!(report["payload"]["error"].is_string(), "{report}");
+                    failed = true;
+                }
+            }
+            _ => {}
+        }
+    }
+    assert!(passed && failed, "a passing header (seen: {passed}) and a failing check (seen: {failed})");
+}
+
