+    /// An account's stored fields are written through the ledger thread, and only by a value that
+    /// says the node is no longer evidence of anything else.
+    #[test]
+    fn accounts_are_written_only_by_a_value_that_says_unsafe() {
+        let (_dir, config, node, _, _) = ledger_of_three_outputs();
+        let agent = Agent::new(json!({}), None, true);
+        let writes = register_ledger(&agent, &config);
+        let mut apply = writes.applier(node.share());
+        let ledger = Blocks(Vec::new());
+
+        let owner = format!("key-{}", "05".repeat(28));
+        let path = format!("ledger/accounts/{owner}");
+        let pool = "0a".repeat(28);
+        let account = json!({
+            "deposit": 2_000_000,
+            "rewards": 77,
+            "pool": { "to": pool, "at": { "slot": 5, "transaction_index": 1, "certificate_index": 2 } },
+            "drep": { "to": "Abstain" },
+        });
+        let owned_up_to = |account: &Json| {
+            let mut account = account.clone();
+            account["unsafe"] = json!(true);
+            account
+        };
+        assert_eq!(list(&agent, "ledger/accounts", None, 10), Vec::<Json>::new());
+        assert_eq!(get(&agent, &path), None);
+
+        let refusal = put(&agent, &path, &account).unwrap_err();
+        assert_eq!(
+            refusal,
+            "ledger/accounts is only written with `\"unsafe\": true` in the value: the node's later behaviour is \
+             evidence of nothing but this edit"
+        );
+        agent.thaw();
+        assert_eq!(put(&agent, &path, &owned_up_to(&account)), Err(NOT_FROZEN.into()));
+        agent.freeze();
+
+        put(&agent, &path, &owned_up_to(&account)).unwrap();
+        assert_eq!(get(&agent, &path), None, "a write is only queued");
+        apply(&ledger);
+        let mut stored = account.clone();
+        stored["drep"]["at"] = json!({ "slot": 0, "transaction_index": 0, "certificate_index": 0 });
+        assert_eq!(get(&agent, &path), Some(stored.clone()));
+
+        // What the read side shows is written back with one change; a script's account is added.
+        let mut richer = owned_up_to(&stored);
+        richer["rewards"] = json!(1_000_000);
+        richer["pool"] = Json::Null;
+        richer["drep"]["to"] = json!({ "Key": "0b".repeat(28) });
+        put(&agent, &path, &richer).unwrap();
+        let script = format!("script-{}", "06".repeat(28));
+        let empty = json!({ "unsafe": true, "deposit": 0, "rewards": 0, "pool": null, "drep": null });
+        put(&agent, &format!("ledger/accounts/{script}"), &empty).unwrap();
+        apply(&ledger);
+        let read = get(&agent, &path).unwrap();
+        assert_eq!(
+            (&read["rewards"], &read["pool"], &read["deposit"]),
+            (&json!(1_000_000), &Json::Null, &json!(2_000_000))
+        );
+        assert_eq!(read["drep"]["to"], json!({ "Key": "0b".repeat(28) }));
+        let all = list(&agent, "ledger/accounts", None, 10);
+        let mut names = keys(&all);
+        names.sort();
+        assert_eq!(names, [owner.clone(), script.clone()]);
+        let first = all[0]["key"].as_str().unwrap();
+        assert_eq!(keys(&list(&agent, "ledger/accounts", Some(first), 10)), [all[1]["key"].as_str().unwrap()]);
+        assert_eq!(keys(&list(&agent, "ledger/accounts", None, 1)), [first]);
+        assert_eq!(keys(&list(&agent, "ledger/accounts/script-", None, 10)), [script.as_str()]);
+        let (provider, _) = agent.state("ledger/accounts").unwrap();
+        assert!(provider.list("", Some("key-00"), 10).unwrap_err().contains("no account `key-00`"));
+
+        // Nothing is zeroed or dropped by omission, and nothing unknown is let through.
+        let without = |field: &str| {
+            let mut account = owned_up_to(&account);
+            account.as_object_mut().unwrap().remove(field);
+            put(&agent, &path, &account).unwrap_err()
+        };
+        assert!(without("rewards").contains("whole number of lovelace for `rewards`"));
+        assert!(without("pool").contains("needs `pool`"));
+        let mut odd = owned_up_to(&account);
+        odd["stake"] = json!(5);
+        assert!(put(&agent, &path, &odd).unwrap_err().contains("not `stake`"));
+        let mut odd = owned_up_to(&account);
+        odd["pool"]["to"] = json!("0a");
+        assert!(put(&agent, &path, &odd).unwrap_err().starts_with("bad `pool.to`"));
+        let mut odd = owned_up_to(&account);
+        odd["pool"]["at"] = json!({ "slot": 5 });
+        assert!(put(&agent, &path, &odd).unwrap_err().contains("`pool.at` needs a whole number `transaction_index`"));
+        assert!(put(&agent, "ledger/accounts/05", &owned_up_to(&account)).unwrap_err().contains("bad credential"));
+        assert!(delete(&agent, &path).unwrap_err().contains("takes no delete"));
+        assert_eq!(
+            put(&agent, &format!("ledger/stake/{owner}"), &json!({ "lovelace": 1 })),
+            Err(STAKE_IS_DERIVED.into())
+        );
+
+        // The reply and the record of the session both say what the node is now worth.
+        assert_eq!(provider.receipt(&owner)["unsafe"], true);
+        assert_eq!(provider.receipt(&owner)["warning"], UNSAFE_WARNING);
+        assert_eq!(provider.receipt(&owner)["queued"], true);
+        let (pots, _) = agent.state("ledger/pots").unwrap();
+        assert_eq!(pots.receipt("pots").get("unsafe"), None);
+        let records: Vec<Json> = (1..=agent.status()["seq"].as_u64().unwrap())
+            .filter_map(|seq| agent.item(seq))
+            .filter(|item| item["kind"] == "store_write")
+            .map(|item| item["payload"].clone())
+            .collect();
+        let record = |key: &str| json!({ "key": key, "op": "put", "unsafe": true, "warning": UNSAFE_WARNING });
+        assert_eq!(records, [record(&owner), record(&owner), record(&script)]);
+        assert_eq!(store_writes(&agent).len(), 3);
+        drop(apply);
+        drop(node);
+    }
+
+    fn in_memory_block(slot: u64, hash: u8, changes: VolatileFragment) -> AnchoredVolatileFragment {
+        let point = Point::Specific(Slot::from(slot), [hash; 32].into(), BlockHeight::from(slot / 10));
+        changes.anchor(point, [hash; 28].into())
+    }
+
+    /// The blocks the ledger holds in memory are read where they live: on the ledger thread,
+    /// between two of its requests.
+    #[test]
+    fn in_memory_blocks_are_read_by_the_ledger_thread() {
+        let (_dir, config, node, inputs, outputs) = ledger_of_three_outputs();
+        let agent = Agent::new(json!({}), None, false);
+        let writes = register_ledger(&agent, &config);
+        let (provider, _) = agent.state("ledger/volatile").unwrap();
+        assert!(provider.list("", None, 10).unwrap_err().starts_with("the ledger thread is not answering"));
+
+        let withdrawing = Credential::KeyHash([5u8; 28].into());
+        let mut spending = VolatileFragment { fees: 170_000, donations: 3, ..VolatileFragment::default() };
+        spending.utxo.produce(inputs[0], Arc::new(outputs[0].clone()));
+        spending.utxo.produce(inputs[1], Arc::new(outputs[1].clone()));
+        spending.utxo.consume(inputs[2]);
+        spending.withdrawals.insert(withdrawing);
+        let blocks = Blocks(vec![
+            in_memory_block(50, 1, spending),
+            in_memory_block(60, 2, VolatileFragment::default()),
+            in_memory_block(70, 3, VolatileFragment { fees: 9, ..VolatileFragment::default() }),
+        ]);
+
+        // The ledger thread: it runs the hook each time it is woken, and at no other time.
+        let mut apply = writes.applier(node.share());
+        let (wake, woken) = mpsc::channel::<()>();
+        writes.woken_by(move || {
+            let _ = wake.send(());
+        });
+        let ledger_thread = std::thread::spawn(move || {
+            while woken.recv().is_ok() {
+                apply(&blocks);
+            }
+        });
+
+        let key = |slot: u64, hash: u8| format!("{slot:020}-{}", hex::encode([hash; 32]));
+        let all = list(&agent, "ledger/volatile", None, 10);
+        assert_eq!(keys(&all), [key(50, 1), key(60, 2), key(70, 3)]);
+        assert_eq!(
+            all[0]["value"],
+            json!({
+                "point": { "slot": 50, "hash": "01".repeat(32), "height": 5 },
+                "issuer": "01".repeat(28),
+                "utxo": { "produced": 2, "consumed": 1 },
+                "pools": { "registered": 0, "retiring": 0 },
+                "accounts": { "changed": 0, "unregistered": 0 },
+                "dreps": { "changed": 0, "unregistered": 0 },
+                "committee": 0,
+                "withdrawals": 1,
+                "proposals": 0,
+                "votes": 0,
+                "fees": 170_000,
+                "donations": 3,
+            })
+        );
+        assert_eq!(all[2]["value"]["fees"], 9);
+        assert_eq!(keys(&list(&agent, "ledger/volatile", None, 2)), [key(50, 1), key(60, 2)]);
+        assert_eq!(keys(&list(&agent, "ledger/volatile", Some(&key(50, 1)), 1)), [key(60, 2)]);
+        assert_eq!(list(&agent, "ledger/volatile", Some(&key(70, 3)), 10), Vec::<Json>::new());
+        assert_eq!(keys(&list(&agent, &format!("ledger/volatile/{:020}", 60), None, 10)), [key(60, 2)]);
+
+        let block = get(&agent, &format!("ledger/volatile/{}", key(50, 1))).unwrap();
+        assert_eq!(block["point"], all[0]["value"]["point"]);
+        assert_eq!(block["utxo"], json!({ "produced": 2, "consumed": 1 }));
+        assert_eq!(
+            block["detail"]["utxo"],
+            json!({
+                "produced": [
+                    { "key": utxo_key(&inputs[0]), "output": cbor_json(&outputs[0]) },
+                    { "key": utxo_key(&inputs[1]), "output": cbor_json(&outputs[1]) },
+                ],
+                "consumed": [utxo_key(&inputs[2])],
+            })
+        );
+        assert_eq!(block["detail"]["withdrawals"], json!([format!("key-{}", "05".repeat(28))]));
+        assert_eq!(block["detail"]["accounts"], json!({ "changed": [], "unregistered": [] }));
+        assert_eq!(get(&agent, &format!("ledger/volatile/{}", "01".repeat(32))), Some(block));
+        assert_eq!(get(&agent, &format!("ledger/volatile/{}", key(51, 1))), None);
+        assert_eq!(get(&agent, &format!("ledger/volatile/{}", "09".repeat(32))), None);
+        assert!(provider.get("nonsense").unwrap_err().contains("bad header hash"));
+
+        // Frozen or not, with or without `unsafe`, the blocks are not written.
+        agent.freeze();
+        assert_eq!(keys(&list(&agent, "ledger/volatile", None, 1)), [key(50, 1)]);
+        let unsafe_value = json!({ "unsafe": true });
+        assert_eq!(
+            put(&agent, &format!("ledger/volatile/{}", key(60, 2)), &unsafe_value),
+            Err(VOLATILE_IS_READ_ONLY.into())
+        );
+        assert_eq!(delete(&agent, &format!("ledger/volatile/{}", key(60, 2))), Err(VOLATILE_IS_READ_ONLY.into()));
+        assert!(VOLATILE_IS_READ_ONLY.starts_with("ledger/volatile is read-only"));
+
+        // A ledger thread that does not get to the question in time is reported as busy.
+        writes.woken_by(|| {});
+        ledger_thread.join().unwrap();
+        let impatient = VolatileState { writes: writes.clone(), answer_within: Duration::from_millis(50) };
+        let busy = impatient.list("", None, 10).unwrap_err();
+        assert!(busy.starts_with("the ledger thread is busy: it did not answer within 0.05 s"), "{busy}");
+        assert!(impatient.get(&key(50, 1)).unwrap_err().starts_with("the ledger thread is busy"));
+
+        drop(writes);
+        drop(impatient);
+        drop(provider);
+        drop(agent);
+        drop(node);
+    }
+}
