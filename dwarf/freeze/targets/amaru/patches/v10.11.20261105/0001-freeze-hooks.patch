+//! Offers every step of the Tokio runtime to the freeze agent, when one is installed.
+//!
+//! With no agent installed each function here returns immediately and the runtime behaves
+//! exactly as it does without this module.
+
+use std::{
+    any::{TypeId, type_name},
+    collections::BTreeMap,
+    future::Future,
+    sync::Arc,
+    time::Duration,
+};
+
+use amaru_freeze::{
+    Draft, StateProvider, Verdict,
+    serde_json::{Value as Json, json},
+    value,
+};
+use cbor4ii::core::utils::BufWriter;
+use futures_util::future::Either;
+use parking_lot::Mutex;
+use tokio::sync::mpsc;
+
+use crate::{
+    ExternalEffect, Instant, Name, ScheduleId, SendData, StageResponse, effect::StageEffect, serde::SendDataValue,
+};
+
+/// The latest state of every stage, and states a debugger asked to put in their place.
+#[derive(Default)]
+struct StageStates {
+    current: Mutex<BTreeMap<String, Json>>,
+    replacements: Mutex<BTreeMap<String, Json>>,
+}
+
+static STAGE_STATES: std::sync::LazyLock<Arc<StageStates>> = std::sync::LazyLock::new(|| {
+    let states = Arc::new(StageStates::default());
+    if let Some(agent) = amaru_freeze::agent() {
+        agent.register_state("stages", states.clone());
+    }
+    states
+});
+
+/// One message per stage whose message type was not known when it was created, kept only for its
+/// concrete type so that injected payloads can be deserialized into it.
+static WITNESSES: std::sync::LazyLock<Mutex<BTreeMap<String, Box<dyn SendData>>>> =
+    std::sync::LazyLock::new(Default::default);
+
+impl StateProvider for StageStates {
+    fn list(&self, prefix: &str, after: Option<&str>, limit: usize) -> Result<Vec<Json>, String> {
+        let current = self.current.lock();
+        Ok(current
+            .iter()
+            .filter(|(name, _)| name.starts_with(prefix) && after.is_none_or(|after| name.as_str() > after))
+            .take(limit)
+            .map(|(name, state)| json!({ "key": name, "value": state }))
+            .collect())
+    }
+
+    fn get(&self, key: &str) -> Result<Option<Json>, String> {
+        Ok(self.current.lock().get(key).cloned())
+    }
+
+    /// The new state takes effect when the stage next receives an input.
+    fn put(&self, key: &str, value: &Json) -> Result<(), String> {
+        if !self.current.lock().contains_key(key) {
+            return Err(format!("no stage named `{key}`"));
+        }
+        let payload = value.get("payload").unwrap_or(value).clone();
+        value::json_to_cbor(&payload)?;
+        self.replacements.lock().insert(key.to_string(), payload);
+        Ok(())
+    }
+
+    fn delete(&self, _key: &str) -> Result<(), String> {
+        Err("a stage's state cannot be deleted".to_string())
+    }
+}
+
+fn to_value(data: &dyn SendData) -> Result<SendDataValue, String> {
+    let mut buffer = cbor4ii::serde::Serializer::new(BufWriter::new(Vec::new()));
+    serde::Serialize::serialize(data, &mut buffer).map_err(|e| e.to_string())?;
+    let bytes = buffer.into_inner().into_inner();
+    cbor4ii::serde::from_slice::<SendDataValue>(&bytes).map_err(|e| e.to_string())
+}
+
+/// The type tag and tagged-JSON payload of a message, or a note saying why it cannot be shown.
+fn describe(data: &dyn SendData) -> (String, Json, bool) {
+    match to_value(data) {
+        Ok(v) => (v.typetag, value::cbor_to_json(&v.value), true),
+        Err(error) => (data.typetag_name().to_string(), json!({ "$unserializable": error }), false),
+    }
+}
+
+/// Turn an edited payload back into the concrete type of `original`.
+fn rebuild(original: &dyn SendData, payload: &Json) -> Result<Box<dyn SendData>, String> {
+    let edited = SendDataValue { typetag: original.typetag_name().to_string(), value: value::json_to_cbor(payload)? };
+    original.deserialize_value(&edited).map_err(|e| format!("{e:#}"))
+}
+
+/// Turn an edited payload back into the concrete type of the effect `original`.
+fn rebuild_effect(original: &dyn ExternalEffect, payload: &Json) -> Result<Box<dyn ExternalEffect>, String> {
+    let edited = SendDataValue { typetag: original.typetag_name().to_string(), value: value::json_to_cbor(payload)? };
+    original.deserialize_effect(&edited).map_err(|e| format!("{e:#}"))
+}
+
+/// Whether an effect comes back equal to itself from what the debugger is shown of it, so that
+/// an edit changes the edited fields and nothing else.
+fn reads_back(original: &dyn ExternalEffect, payload: &Json) -> bool {
+    rebuild_effect(original, payload).is_ok_and(|rebuilt| (&*rebuilt as &dyn SendData).test_eq(original))
+}
+
+/// A duration given as a whole number of milliseconds in `field` of an edited payload.
+fn millis(payload: &Json, field: &str) -> Result<Duration, String> {
+    payload
+        .get(field)
+        .and_then(Json::as_u64)
+        .map(Duration::from_millis)
+        .ok_or_else(|| format!("`{field}` must be a whole number of milliseconds"))
+}
+
+/// A type name without module paths: `a::b::Msg` becomes `Msg`, `(a::X, b::Y)` becomes `(X, Y)`.
+/// Generic arguments are dropped unless the type is a tuple.
+fn short(type_name: &str) -> String {
+    let source = if type_name.starts_with('(') { type_name } else { type_name.split('<').next().unwrap_or(type_name) };
+    let mut out = String::with_capacity(source.len());
+    let mut path = String::new();
+    let flush = |path: &mut String, out: &mut String| {
+        out.push_str(path.rsplit("::").next().unwrap_or(""));
+        path.clear();
+    };
+    for c in source.chars() {
+        if c.is_alphanumeric() || c == '_' || c == ':' {
+            path.push(c);
+        } else {
+            flush(&mut path, &mut out);
+            out.push(c);
+        }
+    }
+    flush(&mut path, &mut out);
+    out
+}
+
+/// How a message in flight is recognised when it arrives: by where it lives on the heap.
+/// Messages without content all live at the same address, so they cannot be told apart.
+fn address(msg: &dyn SendData) -> Option<usize> {
+    (std::mem::size_of_val(msg) != 0).then(|| std::ptr::from_ref(msg).cast::<()>() as usize)
+}
+
+/// Remember that step `sender` of stage `at` sent `msg`, so its arrival can name what caused it.
+pub(crate) fn sent(at: &Name, sender: u64, msg: &dyn SendData) {
+    if sender != 0
+        && amaru_freeze::agent().is_some()
+        && let Some(address) = address(msg)
+    {
+        amaru_freeze::trace::tag(address, sender, amaru_freeze::trace::context(at.as_str()).1);
+    }
+}
+
+/// Run a stage's task so that anything it calls can name the input the stage is handling.
+pub(crate) fn in_stage<F: Future>(name: &Name, stage: F) -> impl Future<Output = F::Output> + use<F> {
+    match amaru_freeze::agent() {
+        Some(_) => Either::Left(amaru_freeze::trace::in_part(name.as_str(), stage)),
+        None => Either::Right(stage),
+    }
+}
+
+fn some(seq: u64) -> Option<u64> {
+    (seq != 0).then_some(seq)
+}
+
+fn refuse(agent: &amaru_freeze::Agent, seq: u64, error: &str) {
+    agent.done(
+        seq,
+        json!({
+            "status": "rejected",
+            "code": "edit_reconstruction_failed",
+            "reason": error,
+        }),
+    );
+    agent.log("error", &format!("item {seq}: edit rejected: {error}"));
+}
+
+fn stage(name: &Name) -> String {
+    format!("stage:{name}")
+}
+
+/// Offer an input to the agent before the stage sees it. `None` means it was dropped.
+pub(crate) async fn input(to: &Name, msg: Box<dyn SendData>) -> Option<(u64, Box<dyn SendData>)> {
+    let Some(agent) = amaru_freeze::agent() else {
+        return Some((0, msg));
+    };
+    let (sender, cause) = address(&*msg).and_then(amaru_freeze::trace::claim).unwrap_or_default();
+    let (type_name, payload, shown) = describe(&*msg);
+    if shown
+        && !WITNESSES.lock().contains_key(to.as_str())
+        && let Ok(witness) = rebuild(&*msg, &payload)
+    {
+        WITNESSES.lock().insert(to.to_string(), witness);
+    }
+    let draft = Draft {
+        kind: "internal_input",
+        to: stage(to),
+        label: short(&type_name),
+        type_name,
+        payload,
+        parent: some(sender),
+        cause: some(cause),
+        editable: shown,
+        droppable: true,
+        ..Draft::default()
+    };
+    let (seq, verdict) = agent.gate(draft).await;
+    // An input nobody is known to have sent starts a chain of its own.
+    amaru_freeze::trace::set_context(to.as_str(), seq, if cause != 0 { cause } else { seq });
+    match verdict {
+        Verdict::Forward => Some((seq, msg)),
+        Verdict::ReplaceRaw(_) | Verdict::ReplaceRawStale(_) => {
+            refuse(agent, seq, "typed_raw_replacement_unsupported: internal inputs require typed reconstruction");
+            None
+        }
+        Verdict::Drop => {
+            agent.done(seq, json!({ "dropped": true }));
+            None
+        }
+        Verdict::Replace(payload) => match rebuild(&*msg, &payload) {
+            Ok(edited) => Some((seq, edited)),
+            Err(error) => {
+                refuse(agent, seq, &error);
+                None
+            }
+        },
+    }
+}
+
+/// Report that the transition started by input `seq` finished, with the stage's new state.
+pub(crate) fn transition_done(seq: u64, at: &Name, state: Option<&dyn SendData>) {
+    let Some(agent) = amaru_freeze::agent() else {
+        return;
+    };
+    match state {
+        Some(state) => {
+            let state_seq = note_state(at, state, Some(seq));
+            agent.done(seq, json!({ "state": state_seq }));
+        }
+        None => {
+            amaru_freeze::trace::forget(at.as_str());
+            agent.done(seq, json!({ "terminated": true }))
+        }
+    }
+}
+
+/// Record a stage's state and make it readable under `stages/<name>`.
+pub(crate) fn note_state(at: &Name, state: &dyn SendData, parent: Option<u64>) -> u64 {
+    let Some(agent) = amaru_freeze::agent() else {
+        return 0;
+    };
+    let (type_name, payload, _) = describe(state);
+    STAGE_STATES.current.lock().insert(at.to_string(), json!({ "type": type_name, "payload": payload }));
+    agent.note(Draft {
+        kind: "internal_state",
+        from: stage(at),
+        label: short(&type_name),
+        type_name,
+        payload,
+        parent,
+        cause: parent.and(some(amaru_freeze::trace::context(at.as_str()).1)),
+        ..Draft::default()
+    })
+}
+
+/// A state the debugger asked to put in place of the stage's current one, if any and if it fits.
+pub(crate) fn replacement_state(at: &Name, current: &dyn SendData) -> Option<Box<dyn SendData>> {
+    let agent = amaru_freeze::agent()?;
+    let payload = STAGE_STATES.replacements.lock().remove(at.as_str())?;
+    match rebuild(current, &payload) {
+        Ok(state) => {
+            agent.log("info", &format!("stage `{at}`: state replaced"));
+            Some(state)
+        }
+        Err(error) => {
+            agent.log("error", &format!("stage `{at}`: replacement state rejected: {error}"));
+            None
+        }
+    }
+}
+
+type BoxedEffect = StageEffect<Box<dyn SendData>>;
+
+/// What the interpreter does with an effect once the agent has seen it.
+pub(crate) enum Gated {
+    Run(BoxedEffect),
+    /// The effect does not run; the stage resumes as if it had.
+    Skipped,
+    /// A wait does not run; the stage resumes at once with the current time.
+    WaitSkipped,
+    /// A non-blocking send does not run; the stage is told the message was queued.
+    TrySendSkipped,
+    /// A schedule runs under the id the stage already holds, but fires this long from now on the
+    /// stage clock instead of at the time the id names.
+    Rescheduled(BoxedEffect, Duration),
+    /// The requested replacement was invalid. The original effect must not run.
+    Rejected,
+}
+
+/// What a debugger may put in place of a held schedule: `at_ms`, the time until it fires counted
+/// from now on the stage clock, `message`, the message it delivers, or both. The `at` the schedule
+/// is shown with may be sent back unchanged; any other field is refused.
+fn edit_schedule(
+    msg: &dyn SendData,
+    id: &ScheduleId,
+    payload: &Json,
+) -> Result<(Option<Box<dyn SendData>>, Option<Duration>), String> {
+    let fields = payload.as_object().ok_or("a schedule is edited with an object holding `at_ms`, `message` or both")?;
+    let (mut message, mut fires_after) = (None, None);
+    for (field, given) in fields {
+        match field.as_str() {
+            "at_ms" => fires_after = Some(millis(payload, "at_ms")?),
+            "message" => message = Some(rebuild(msg, given)?),
+            "at" if *given == json!(format!("{}", id.time())) => {}
+            "at" => {
+                return Err("`at` is only shown; move the schedule with `at_ms`, a whole number of milliseconds \
+                            from now on the stage clock"
+                    .to_string());
+            }
+            unknown => return Err(format!("unknown field `{unknown}`: a schedule has `at_ms` and `message`")),
+        }
+    }
+    Ok((message, fires_after))
+}
+
+/// Apply an edited payload to an effect. A payload the effect refuses gives the original back
+/// together with the reason. A schedule that was moved keeps its id; `fires_after` is set to the
+/// time from now at which it is to fire.
+fn edit(effect: BoxedEffect, payload: &Json, fires_after: &mut Option<Duration>) -> (BoxedEffect, Option<String>) {
+    match effect {
+        StageEffect::Schedule(msg, id) => match edit_schedule(&*msg, &id, payload) {
+            Ok((edited, moved)) => {
+                *fires_after = moved;
+                (StageEffect::Schedule(edited.unwrap_or(msg), id), None)
+            }
+            Err(error) => (StageEffect::Schedule(msg, id), Some(error)),
+        },
+        StageEffect::Send(target, call, msg) => match rebuild(&*msg, payload) {
+            Ok(edited) => (StageEffect::Send(target, call, edited), None),
+            Err(error) => (StageEffect::Send(target, call, msg), Some(error)),
+        },
+        StageEffect::TrySend(target, msg) => match rebuild(&*msg, payload) {
+            Ok(edited) => (StageEffect::TrySend(target, edited), None),
+            Err(error) => (StageEffect::TrySend(target, msg), Some(error)),
+        },
+        StageEffect::Wait(duration) => match millis(payload, "ms") {
+            Ok(edited) => (StageEffect::Wait(edited), None),
+            Err(error) => (StageEffect::Wait(duration), Some(error)),
+        },
+        StageEffect::Call(target, timeout, msg) => match millis(payload, "timeout_ms") {
+            Ok(edited) => (StageEffect::Call(target, edited, msg), None),
+            Err(error) => (StageEffect::Call(target, timeout, msg), Some(error)),
+        },
+        StageEffect::SetTimeout { slot, delay, msg } => {
+            let unchanged = |field: &str, original: Json| payload.get(field).is_none_or(|given| *given == original);
+            let edited = if unchanged("slot", json!(slot)) && unchanged("message", describe(&*msg).1) {
+                millis(payload, "delay_ms")
+            } else {
+                Err("only `delay_ms` can be edited".to_string())
+            };
+            match edited {
+                Ok(edited) => (StageEffect::SetTimeout { slot, delay: edited, msg }, None),
+                Err(error) => (StageEffect::SetTimeout { slot, delay, msg }, Some(error)),
+            }
+        }
+        StageEffect::External(external) => match rebuild_effect(&*external, payload) {
+            Ok(edited) => (StageEffect::External(edited), None),
+            Err(error) => (StageEffect::External(external), Some(error)),
+        },
+        other @ (StageEffect::Receive
+        | StageEffect::Clock
+        | StageEffect::CancelSchedule(_)
+        | StageEffect::ClearTimeout { .. }
+        | StageEffect::Detach(..)
+        | StageEffect::Terminate
+        | StageEffect::AddStage(_)
+        | StageEffect::WireStage(..)) => (other, Some("this effect cannot be edited".to_string())),
+    }
+}
+
+/// Offer an effect to the agent before it runs.
+///
+/// Returns the item's sequence number and what to do with the effect. A send, a schedule or a
+/// timeout that was dropped is skipped; so is a dropped wait, which then returns at once. An
+/// edited effect runs in its edited form; an invalid edit never runs the original effect. A schedule
+/// that was moved is still known to the stage by its original id, so that id is kept and only
+/// the time at which it fires changes.
+pub(crate) async fn action(at: &Name, parent: u64, effect: BoxedEffect) -> (u64, Gated) {
+    let Some(agent) = amaru_freeze::agent() else {
+        return (0, Gated::Run(effect));
+    };
+    // An effect that exists only to offer something to the agent is not itself a step of the node.
+    if let StageEffect::External(external) = &effect
+        && external.typetag_name().ends_with("::FreezeProtoEffect")
+    {
+        return (0, Gated::Run(effect));
+    }
+    let mut draft = Draft {
+        kind: "internal_action",
+        from: stage(at),
+        parent: some(parent),
+        cause: some(amaru_freeze::trace::context(at.as_str()).1),
+        ..Draft::default()
+    };
+    match &effect {
+        StageEffect::Send(target, call, msg) => {
+            let (type_name, payload, shown) = describe(&**msg);
+            draft.to = stage(target);
+            draft.label = if call.is_some() { "reply".to_string() } else { "send".to_string() };
+            draft.payload = payload;
+            draft.type_name = type_name;
+            draft.editable = shown;
+            draft.droppable = true;
+        }
+        StageEffect::TrySend(target, msg) => {
+            let (type_name, payload, shown) = describe(&**msg);
+            draft.to = stage(target);
+            draft.label = "try send".to_string();
+            draft.payload = payload;
+            draft.type_name = type_name;
+            draft.editable = shown;
+            draft.droppable = true;
+        }
+        StageEffect::Call(target, timeout, _) => {
+            draft.to = stage(target);
+            draft.label = "call".to_string();
+            draft.payload = json!({ "timeout_ms": timeout.as_millis() as u64 });
+            draft.editable = true;
+        }
+        StageEffect::External(external) => {
+            let (type_name, payload, shown) = describe(&**external as &dyn SendData);
+            draft.editable = shown && reads_back(&**external, &payload);
+            draft.label = short(&type_name);
+            draft.type_name = type_name;
+            draft.payload = payload;
+            draft.to = "node".to_string();
+        }
+        StageEffect::Detach(external, _) => {
+            let (type_name, payload, _) = describe(&**external as &dyn SendData);
+            draft.label = short(&type_name);
+            draft.type_name = type_name;
+            draft.payload = payload;
+            draft.to = "node".to_string();
+        }
+        StageEffect::Wait(duration) => {
+            draft.label = "wait".to_string();
+            draft.payload = json!({ "ms": duration.as_millis() as u64 });
+            draft.editable = true;
+            draft.droppable = true;
+        }
+        StageEffect::Schedule(msg, id) => {
+            let (type_name, payload, _) = describe(&**msg);
+            draft.label = "schedule".to_string();
+            draft.type_name = type_name;
+            draft.payload = json!({ "at": format!("{}", id.time()), "message": payload });
+            draft.editable = true;
+            draft.droppable = true;
+        }
+        StageEffect::SetTimeout { slot, delay, msg } => {
+            let (type_name, payload, _) = describe(&**msg);
+            draft.label = "set timeout".to_string();
+            draft.type_name = type_name;
+            draft.payload = json!({ "slot": slot, "delay_ms": delay.as_millis() as u64, "message": payload });
+            draft.editable = true;
+            draft.droppable = true;
+        }
+        StageEffect::ClearTimeout { slot } => {
+            draft.label = "clear timeout".to_string();
+            draft.payload = json!({ "slot": slot });
+        }
+        StageEffect::CancelSchedule(id) => {
+            draft.label = "cancel schedule".to_string();
+            draft.payload = json!({ "at": format!("{}", id.time()) });
+        }
+        StageEffect::Clock => draft.label = "clock".to_string(),
+        StageEffect::Terminate => draft.label = "terminate".to_string(),
+        StageEffect::AddStage(name) => {
+            draft.label = "add stage".to_string();
+            draft.payload = json!({ "name": name.as_str() });
+        }
+        StageEffect::WireStage(name, _, initial_state, _, _) => {
+            let (type_name, payload, _) = describe(&**initial_state);
+            draft.label = "start stage".to_string();
+            draft.to = stage(name);
+            draft.type_name = type_name;
+            draft.payload = payload;
+        }
+        StageEffect::Receive => draft.label = "receive".to_string(),
+    }
+
+    let (seq, verdict) = agent.gate(draft).await;
+    let mut fires_after = None;
+    let effect = match (verdict, effect) {
+        (Verdict::Drop, StageEffect::Send(..) | StageEffect::Schedule(..) | StageEffect::SetTimeout { .. }) => {
+            agent.done(seq, json!({ "dropped": true }));
+            return (seq, Gated::Skipped);
+        }
+        (Verdict::Drop, StageEffect::TrySend(..)) => {
+            agent.done(seq, json!({ "dropped": true }));
+            return (seq, Gated::TrySendSkipped);
+        }
+        (Verdict::Drop, StageEffect::Wait(_)) => {
+            agent.done(seq, json!({ "dropped": true }));
+            return (seq, Gated::WaitSkipped);
+        }
+        (Verdict::Replace(payload), effect) => {
+            let (effect, refused) = edit(effect, &payload, &mut fires_after);
+            if let Some(error) = refused {
+                refuse(agent, seq, &error);
+                return match effect {
+                    StageEffect::Wait(_) => (seq, Gated::WaitSkipped),
+                    StageEffect::TrySend(..) => (seq, Gated::TrySendSkipped),
+                    StageEffect::Send(..) | StageEffect::Schedule(..) | StageEffect::SetTimeout { .. } => {
+                        (seq, Gated::Skipped)
+                    }
+                    StageEffect::Receive
+                    | StageEffect::Call(..)
+                    | StageEffect::Clock
+                    | StageEffect::CancelSchedule(_)
+                    | StageEffect::ClearTimeout { .. }
+                    | StageEffect::External(_)
+                    | StageEffect::Detach(..)
+                    | StageEffect::Terminate
+                    | StageEffect::AddStage(_)
+                    | StageEffect::WireStage(..) => (seq, Gated::Rejected),
+                };
+            }
+            effect
+        }
+        (_, effect) => effect,
+    };
+    if let StageEffect::Send(_, None, msg)
+    | StageEffect::TrySend(_, msg)
+    | StageEffect::Schedule(msg, _)
+    | StageEffect::SetTimeout { msg, .. } = &effect
+    {
+        sent(at, seq, &**msg);
+    }
+    match fires_after {
+        Some(fires_after) => (seq, Gated::Rescheduled(effect, fires_after)),
+        None => (seq, Gated::Run(effect)),
+    }
+}
+
+/// Offer the result of an external effect to the agent before the stage sees it.
+pub(crate) async fn result(at: &Name, action: u64, response: Box<dyn SendData>) -> Result<Box<dyn SendData>, String> {
+    let Some(agent) = amaru_freeze::agent() else {
+        return Ok(response);
+    };
+    if action == 0 {
+        return Ok(response);
+    }
+    let (type_name, payload, shown) = describe(&*response);
+    let draft = Draft {
+        kind: "internal_result",
+        to: stage(at),
+        from: "node".to_string(),
+        label: short(&type_name),
+        type_name,
+        payload,
+        parent: some(action),
+        cause: some(amaru_freeze::trace::context(at.as_str()).1),
+        editable: shown,
+        ..Draft::default()
+    };
+    let (seq, verdict) = agent.gate(draft).await;
+    match verdict {
+        Verdict::Replace(payload) => match rebuild(&*response, &payload) {
+            Ok(edited) => Ok(edited),
+            Err(error) => {
+                refuse(agent, seq, &error);
+                Err(error)
+            }
+        },
+        Verdict::Forward | Verdict::Drop => Ok(response),
+        Verdict::ReplaceRaw(_) | Verdict::ReplaceRawStale(_) => {
+            let error = "typed_raw_replacement_unsupported: internal results require typed reconstruction".to_string();
+            refuse(agent, seq, &error);
+            Err(error)
+        }
+    }
+}
+
+/// Record what a non-external effect answered.
+pub(crate) fn resumed(action: u64, response: &StageResponse) {
+    let Some(agent) = amaru_freeze::agent() else {
+        return;
+    };
+    let outcome = match response {
+        StageResponse::Unit => return,
+        StageResponse::ClockResponse(now) | StageResponse::WaitResponse(now) => json!({ "now": format!("{now}") }),
+        StageResponse::CallResponse(msg) => {
+            let (type_name, payload, _) = describe(&**msg);
+            json!({ "type": type_name, "payload": payload })
+        }
+        StageResponse::TrySend(outcome) => json!({ "outcome": format!("{outcome:?}") }),
+        StageResponse::CancelScheduleResponse(cancelled) => json!({ "cancelled": cancelled }),
+        StageResponse::AddStageResponse(name) => json!({ "name": name.as_str() }),
+        StageResponse::ExternalResponse(_) => return,
+    };
+    agent.done(action, outcome);
+}
+
+/// Deserializes a generic value into the message type of one stage.
+type Decoder = fn(&dyn SendData) -> anyhow::Result<Box<dyn SendData>>;
+
+/// Let a debugger send messages into the mailbox of a stage whose message type is `Msg`.
+///
+/// Injection is available from the moment the stage exists.
+pub(crate) fn register_typed_stage<Msg: SendData>(name: &Name, mailbox: &mpsc::Sender<Box<dyn SendData>>) {
+    let erased = TypeId::of::<Msg>() == TypeId::of::<Box<dyn SendData>>();
+    register(name, mailbox, (!erased).then_some((type_name::<Msg>(), Msg::deserialize_boxed as Decoder)));
+}
+
+/// Let a debugger send messages into the mailbox of a stage whose message type is not known here.
+///
+/// The message type is learned from the first input the stage receives, so injection is
+/// available once the stage has handled one message.
+pub(crate) fn register_stage(name: &Name, mailbox: &mpsc::Sender<Box<dyn SendData>>) {
+    register(name, mailbox, None);
+}
+
+fn register(name: &Name, mailbox: &mpsc::Sender<Box<dyn SendData>>, decoder: Option<(&'static str, Decoder)>) {
+    let mailbox = mailbox.clone();
+    let Some(agent) = amaru_freeze::agent() else {
+        return;
+    };
+    let _ = &*STAGE_STATES;
+    let key = name.to_string();
+    agent.register_injector(
+        &stage(name),
+        Arc::new(move |payload: &Json| {
+            let msg = match decoder {
+                Some((typetag, decode)) => {
+                    let value = SendDataValue { typetag: typetag.to_string(), value: value::json_to_cbor(payload)? };
+                    decode(&value).map_err(|e| format!("{e:#}"))?
+                }
+                None => {
+                    let witnesses = WITNESSES.lock();
+                    let witness = witnesses
+                        .get(&key)
+                        .ok_or("this stage has not received a message yet, so its message type is not known")?;
+                    rebuild(&**witness, payload)?
+                }
+            };
+            mailbox.try_send(msg).map_err(|e| match e {
+                mpsc::error::TrySendError::Full(_) => "the stage's mailbox is full; step it first".to_string(),
+                mpsc::error::TrySendError::Closed(_) => "the stage has stopped".to_string(),
+            })
+        }),
+    );
+}
+
+/// Time spent frozen before the runtime's clock started; it never shows up on that clock.
+static FROZEN_BEFORE_EPOCH: std::sync::LazyLock<Duration> = std::sync::LazyLock::new(|| {
+    std::sync::LazyLock::force(&crate::EPOCH);
+    amaru_freeze::agent().map(|agent| agent.frozen_time()).unwrap_or_default()
+});
+
+/// How far the stages' clock lags the real one: the time spent frozen since the clock started.
+fn lag(agent: &amaru_freeze::Agent) -> Duration {
+    agent.frozen_time().saturating_sub(*FROZEN_BEFORE_EPOCH)
+}
+
+/// The runtime's clock with the time spent frozen taken out, so a freeze is invisible to stages.
+pub(crate) fn now(real: Instant) -> Instant {
+    match amaru_freeze::agent() {
+        Some(agent) => real - lag(agent),
+        None => real,
+    }
+}
+
+/// Sleep until `deadline` on the stages' clock, which does not advance while frozen.
+pub(crate) async fn sleep_until(deadline: tokio::time::Instant) {
+    let Some(agent) = amaru_freeze::agent() else {
+        return tokio::time::sleep_until(deadline).await;
+    };
+    loop {
+        agent.until_thawed().await;
+        let lagging = lag(agent);
+        tokio::time::sleep_until(deadline + lagging).await;
+        if !agent.is_frozen() && lag(agent) == lagging {
+            return;
+        }
+    }
+}
+
+/// The instant `duration` from now on the stages' clock, for [`sleep_until`] and [`timeout_at`].
+pub(crate) fn deadline(duration: Duration) -> tokio::time::Instant {
+    match amaru_freeze::agent() {
+        Some(agent) => tokio::time::Instant::now() - lag(agent) + duration,
+        None => tokio::time::Instant::now() + duration,
+    }
+}
+
+pub(crate) async fn sleep(duration: Duration) {
+    match amaru_freeze::agent() {
+        Some(_) => sleep_until(deadline(duration)).await,
+        None => tokio::time::sleep(duration).await,
+    }
+}
+
+/// Like [`tokio::time::timeout_at`] with a deadline on the stages' clock, so time spent frozen
+/// does not count towards the limit. `None` means the deadline passed first.
+pub(crate) async fn timeout_at<F: Future>(deadline: tokio::time::Instant, future: F) -> Option<F::Output> {
+    if amaru_freeze::agent().is_none() {
+        return tokio::time::timeout_at(deadline, future).await.ok();
+    }
+    tokio::select! { biased;
+        output = future => Some(output),
+        _ = sleep_until(deadline) => None,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::short;
+
+    #[test]
+    fn type_names_lose_their_module_paths() {
+        assert_eq!(short("amaru_consensus::stages::select_chain::SelectChainMsg"), "SelectChainMsg");
+        assert_eq!(short("core::option::Option<amaru_kernel::Header>"), "Option");
+        assert_eq!(short("(a::b::ProtoState, c::ChainSyncInitiator)"), "(ProtoState, ChainSyncInitiator)");
+        assert_eq!(short("[u8; 32]"), "[u8; 32]");
+        assert_eq!(short("()"), "()");
+    }
+}
