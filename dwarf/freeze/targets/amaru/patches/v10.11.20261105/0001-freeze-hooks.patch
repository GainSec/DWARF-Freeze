+use crate::{blockfetch, chainsync};
+
+const KES_BYTES: usize = 608;
+const VRF_SECRET_BYTES: usize = 64;
+
+#[derive(Debug)]
+pub struct ResignError(String);
+
+impl ResignError {
+    pub(crate) fn new(message: impl Into<String>) -> Self {
+        Self(message.into())
+    }
+
+    pub(crate) fn code(&self) -> Option<&str> {
+        self.0.split_once(':').map(|(code, _)| code)
+    }
+}
+
+impl fmt::Display for ResignError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(&self.0)
+    }
+}
+
+impl std::error::Error for ResignError {}
+
+#[derive(Debug)]
+pub struct SignedHeader {
+    pub bytes: Vec<u8>,
+    pub original_hash: HeaderHash,
+    pub signed_hash: HeaderHash,
+}
+
+/// The same multiplexer carries both directions of ChainSync traffic. Ancestry rewrites must
+/// never cross that boundary: an edited producer response cannot rewrite a consumer request (or
+/// vice versa) merely because both messages share a mux name.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ChainSyncDirection {
+    Inbound,
+    Outbound,
+}
+
+impl ChainSyncDirection {
+    fn stream(self, mux: &str) -> String {
+        let direction = match self {
+            Self::Inbound => "inbound",
+            Self::Outbound => "outbound",
+        };
+        format!("{direction}:{mux}")
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
+pub struct BlockFetchRequest {
+    requested_from: NetworkPoint,
+    requested_through: NetworkPoint,
+    producer_from: NetworkPoint,
+    producer_through: NetworkPoint,
+    expected: BTreeMap<NetworkPoint, NetworkPoint>,
+    complete: bool,
+    request_id: u64,
+    scope: String,
+}
+
+impl BlockFetchRequest {
+    pub fn new(
+        requested_from: NetworkPoint,
+        requested_through: NetworkPoint,
+        producer_from: NetworkPoint,
+        producer_through: NetworkPoint,
+    ) -> Self {
+        let mut request = Self {
+            requested_from,
+            requested_through,
+            producer_from,
+            producer_through,
+            expected: BTreeMap::new(),
+            complete: true,
+            request_id: 0,
+            scope: String::new(),
+        };
+        request.expect_endpoint(requested_from, producer_from);
+        request.expect_endpoint(requested_through, producer_through);
+        request
+    }
+
+    pub fn producer_range(&self) -> (NetworkPoint, NetworkPoint) {
+        (self.producer_from, self.producer_through)
+    }
+
+    fn expect_endpoint(&mut self, requested: NetworkPoint, producer: NetworkPoint) {
+        if requested != producer {
+            self.expected.insert(producer, requested);
+        }
+    }
+}
+
+pub struct Resigner {
+    enabled: AtomicBool,
+    config: Option<PathBuf>,
+}
+
+#[derive(Clone)]
+struct Mapping {
+    original: NetworkPoint,
+    signed_header: Vec<u8>,
+    original_parent: Option<HeaderHash>,
+    signed_parent: Option<HeaderHash>,
+}
+
+struct BlockFetchActivity {
+    scope: String,
+    consumed: BTreeSet<NetworkPoint>,
+}
+
+pub struct Coordinator {
+    /// Fetch scheduling can select any producer that has the original block, so point mappings
+    /// are global to this one controlled devnet process and guarded by exact point/body checks.
+    mappings: Mutex<BTreeMap<NetworkPoint, Mapping>>,
+    /// Per-connection typed BlockFetch requests consume each expected edited point at most once.
+    /// The mapping itself remains available to independently issued peer requests and refetches.
+    active_requests: Mutex<BTreeMap<u64, BlockFetchActivity>>,
+    next_request_id: AtomicU64,
+    /// Parent rewrites are valid only within the ChainSync stream that announced the edit.
+    ancestry: Mutex<BTreeMap<String, BTreeMap<HeaderHash, HeaderHash>>>,
+}
+
+impl Default for Coordinator {
+    fn default() -> Self {
+        Self {
+            mappings: Mutex::default(),
+            active_requests: Mutex::default(),
+            next_request_id: AtomicU64::new(1),
+            ancestry: Mutex::default(),
+        }
+    }
+}
+
+impl Coordinator {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    pub fn pending(&self, _scope: &str) -> usize {
+        self.mappings.lock().len()
+    }
+
+    pub fn clear(&self) {
+        self.mappings.lock().clear();
+        self.active_requests.lock().clear();
+        self.ancestry.lock().clear();
+    }
+
+    /// Discard connection-local ancestry and responder leases when a mux disconnects or is reused.
+    pub fn disconnect(&self, mux: &str) {
+        let mut ancestry = self.ancestry.lock();
+        ancestry.remove(&ChainSyncDirection::Inbound.stream(mux));
+        ancestry.remove(&ChainSyncDirection::Outbound.stream(mux));
+        let scope = format!("responder:{mux}");
+        self.active_requests.lock().retain(|_, request| request.scope != scope);
+    }
+
+    pub fn chain_sync(
+        &self,
+        resigner: &Resigner,
+        direction: ChainSyncDirection,
+        mux: &str,
+        _peer: &str,
+        original: &[u8],
+        edited: &[u8],
+    ) -> Result<Vec<u8>, ResignError> {
+        let stream = direction.stream(mux);
+        if !resigner.enabled() {
+            return Ok(edited.to_vec());
+        }
+        let original_message: chainsync::Message = decode_message("original ChainSync", original)?;
+        if matches!(original_message, chainsync::Message::RollBackward(_, _)) {
+            self.ancestry.lock().remove(&stream);
+        }
+        let edited_message: chainsync::Message = decode_message("edited ChainSync", edited)
+            .map_err(|error| ResignError::new(format!("edited_message_not_decodable: {error}")))?;
+        if original_message.message_type() != edited_message.message_type() {
+            return Err(ResignError::new(format!(
+                "mini_protocol_transition_changed: an edited ChainSync message may not change from {} to {}",
+                original_message.message_type(),
+                edited_message.message_type()
+            )));
+        }
+        let chainsync::Message::RollForward(original_content, _) = original_message else {
+            if original != edited {
+                return Err(ResignError::new(
+                    "protocol_dependency_graph_unavailable: controlled ChainSync repair supports RollForward header edits only",
+                ));
+            }
+            return Ok(original.to_vec());
+        };
+        let chainsync::Message::RollForward(mut edited_content, mut edited_tip) = edited_message else {
+            unreachable!("matching message types were checked above");
+        };
+        if original_content.variant != edited_content.variant {
+            return Err(ResignError::new(
+                "era_identity_change_forbidden: the ChainSync header era tag is an identity invariant",
+            ));
+        }
+        if original_content.variant != amaru_kernel::EraName::Conway {
+            return Err(ResignError::new(format!(
+                "unsupported_header_era: the controlled repair chain supports Conway headers, not {:?}",
+                original_content.variant
+            )));
+        }
+        let original_header: Header = decode_header("original", &original_content.cbor)?;
+        let edited_header: Header = decode_header("edited", &edited_content.cbor)?;
+        if let Some(parent) = edited_header.body().prev_hash {
+            let rewritten_parent = self.ancestry.lock().get(&stream).and_then(|by_hash| by_hash.get(&parent).copied());
+            if let Some(rewritten_parent) = rewritten_parent {
+                let mut body = edited_header.body().clone();
+                body.prev_hash = Some(rewritten_parent);
+                edited_content.cbor = to_cbor(&(body, *edited_header.signature()));
+            }
+        }
+        let Some(signed) = resigner.resign_header(&original_content.cbor, &edited_content.cbor)? else {
+            return Ok(edited.to_vec());
+        };
+        let signed_header: Header = decode_header("signed", &signed.bytes)?;
+        if edited_tip.hash() == original_header.hash() && edited_tip.slot() == original_header.slot() {
+            edited_tip = Point::Specific(signed_header.slot(), signed_header.hash(), signed_header.block_height());
+        }
+        edited_content.cbor = signed.bytes.clone();
+
+        let edited_point = NetworkPoint::Specific(signed_header.slot(), signed_header.hash());
+        let original_point = NetworkPoint::Specific(original_header.slot(), original_header.hash());
+        self.mappings.lock().insert(
+            edited_point,
+            Mapping {
+                original: original_point,
+                signed_header: signed.bytes,
+                original_parent: original_header.body().prev_hash,
+                signed_parent: signed_header.body().prev_hash,
+            },
+        );
+        self.ancestry.lock().entry(stream).or_default().insert(original_header.hash(), signed_header.hash());
+
+        Ok(to_cbor(&chainsync::Message::RollForward(edited_content, edited_tip)))
+    }
+
+    pub fn blockfetch_out(&self, _peer: &str, original: &[u8], edited: &[u8]) -> Result<Vec<u8>, ResignError> {
+        let original_message: blockfetch::Message = decode_message("original outbound BlockFetch", original)?;
+        let edited_message: blockfetch::Message = decode_message("edited outbound BlockFetch", edited)
+            .map_err(|error| ResignError::new(format!("edited_message_not_decodable: {error}")))?;
+        if original_message.message_type() != edited_message.message_type() {
+            return Err(ResignError::new(format!(
+                "mini_protocol_transition_changed: an edited BlockFetch message may not change from {} to {}",
+                original_message.message_type(),
+                edited_message.message_type()
+            )));
+        }
+        let (blockfetch::Message::RequestRange(_), blockfetch::Message::RequestRange(mut range)) =
+            (original_message, edited_message)
+        else {
+            if original != edited {
+                return Err(ResignError::new(
+                    "protocol_dependency_graph_unavailable: controlled outbound BlockFetch repair supports RequestRange edits only",
+                ));
+            }
+            return Ok(original.to_vec());
+        };
+        let original = (range.from, range.through);
+        (range.from, range.through) = self.translate_blockfetch_range(range.from, range.through);
+        let changed = original != (range.from, range.through);
+        if changed { Ok(to_cbor(&blockfetch::Message::from(range))) } else { Ok(edited.to_vec()) }
+    }
+
+    /// Translate the edited points selected by consensus back to points the producer can serve.
+    ///
+    /// BlockFetch uses a custom typed driver rather than the generic mini-protocol driver, so the
+    /// production path calls this method before constructing its wire `RequestRange`.
+    pub fn translate_blockfetch_range(
+        &self,
+        from: NetworkPoint,
+        through: NetworkPoint,
+    ) -> (NetworkPoint, NetworkPoint) {
+        let mappings = self.mappings.lock();
+        let translate = |point| mappings.get(&point).map_or(point, |mapping| mapping.original);
+        (translate(from), translate(through))
+    }
+
+    /// Capture the exact edited branch represented by one typed BlockFetch request.
+    ///
+    /// The immutable snapshot binds every mapped response in the range, not only the two range
+    /// endpoints. Each independently issued peer request receives its own identity, so a repeated
+    /// response for one request fails closed without revoking legitimate concurrent stragglers.
+    pub fn blockfetch_request(&self, from: NetworkPoint, through: NetworkPoint) -> BlockFetchRequest {
+        self.blockfetch_request_in_scope("initiator", from, through)
+    }
+
+    pub fn responder_blockfetch_request(
+        &self,
+        mux: &str,
+        from: NetworkPoint,
+        through: NetworkPoint,
+    ) -> BlockFetchRequest {
+        self.blockfetch_request_in_scope(&format!("responder:{mux}"), from, through)
+    }
+
+    fn blockfetch_request_in_scope(&self, scope: &str, from: NetworkPoint, through: NetworkPoint) -> BlockFetchRequest {
+        let mappings = self.mappings.lock();
+        let translate = |point| mappings.get(&point).map_or(point, |mapping| mapping.original);
+        let producer_from = translate(from);
+        let producer_through = translate(through);
+        let mut request = BlockFetchRequest::new(from, through, producer_from, producer_through);
+        request.scope = scope.to_string();
+        let lower = producer_from.slot_or_default().min(producer_through.slot_or_default());
+        let upper = producer_from.slot_or_default().max(producer_through.slot_or_default());
+        let mut current = through;
+        let mut visited = BTreeSet::new();
+
+        while visited.insert(current) {
+            let Some(mapping) = mappings.get(&current) else {
+                break;
+            };
+            let slot = mapping.original.slot_or_default();
+            if slot < lower {
+                break;
+            }
+            if slot <= upper {
+                request.expected.insert(mapping.original, current);
+            }
+            if current == from {
+                break;
+            }
+            let Some(parent) = mapping.signed_parent else {
+                break;
+            };
+            let Some(parent_point) = mappings.keys().find(|point| point.hash() == parent).copied() else {
+                if mapping.signed_parent != mapping.original_parent {
+                    request.complete = false;
+                }
+                break;
+            };
+            current = parent_point;
+        }
+
+        if !request.expected.is_empty() {
+            let request_id = self.next_request_id.fetch_add(1, Ordering::Relaxed);
+            if request_id == 0 {
+                request.complete = false;
+            } else {
+                request.request_id = request_id;
+                self.active_requests
+                    .lock()
+                    .insert(request_id, BlockFetchActivity { scope: request.scope.clone(), consumed: BTreeSet::new() });
+            }
+        }
+
+        request
+    }
+
+    pub fn rewrite_responder_block(
+        &self,
+        mux: &str,
+        request: &BlockFetchRequest,
+        network_block: NetworkBlock,
+    ) -> Result<NetworkBlock, ResignError> {
+        let expected_scope = format!("responder:{mux}");
+        if request.scope != expected_scope {
+            return Err(ResignError::new(format!(
+                "the BlockFetch responder request mux identity is {}, not {expected_scope}",
+                request.scope
+            )));
+        }
+        self.rewrite_blockfetch_block_inner(network_block, Some(request.clone())).map(|(block, _)| block)
+    }
+
+    /// Release replay-tracking state when one connection's typed BlockFetch batch terminates.
+    /// Signed-header mappings deliberately outlive the request so concurrent peers and later
+    /// refetches can still translate the edited points to producer points.
+    pub fn finish_blockfetch_request(&self, request: &BlockFetchRequest) {
+        if request.request_id != 0 {
+            self.active_requests.lock().remove(&request.request_id);
+        }
+    }
+
+    pub fn blockfetch_in(&self, _peer: &str, original: &[u8], edited: &[u8]) -> Result<Vec<u8>, ResignError> {
+        self.blockfetch_in_inner(original, edited, None)
+    }
+
+    pub fn blockfetch_in_for_range(
+        &self,
+        _peer: &str,
+        request: BlockFetchRequest,
+        original: &[u8],
+        edited: &[u8],
+    ) -> Result<Vec<u8>, ResignError> {
+        self.blockfetch_in_inner(original, edited, Some(request))
+    }
+
+    pub fn blockfetch_out_for_range(
+        &self,
+        mux: &str,
+        request: BlockFetchRequest,
+        original: &[u8],
+        edited: &[u8],
+    ) -> Result<Vec<u8>, ResignError> {
+        let expected_scope = format!("responder:{mux}");
+        if request.scope != expected_scope {
+            return Err(ResignError::new(format!(
+                "the BlockFetch responder request mux identity is {}, not {expected_scope}",
+                request.scope
+            )));
+        }
+        self.blockfetch_in_inner(original, edited, Some(request))
+    }
+
+    fn blockfetch_in_inner(
+        &self,
+        original: &[u8],
+        edited: &[u8],
+        request: Option<BlockFetchRequest>,
+    ) -> Result<Vec<u8>, ResignError> {
+        let original_message: blockfetch::Message = decode_message("original inbound BlockFetch", original)?;
+        let blockfetch::Message::Block(original_block) = original_message else {
+            if original != edited {
+                return Err(ResignError::new("an edited BlockFetch message may not change its message type"));
+            }
+            return Ok(edited.to_vec());
+        };
+        let edited_message: blockfetch::Message = decode_message("edited inbound BlockFetch", edited)?;
+        let blockfetch::Message::Block(edited_block) = edited_message else {
+            return Err(ResignError::new("an edited BlockFetch block may not change its message type"));
+        };
+        let original_network_block: NetworkBlock = from_cbor_no_leftovers(&original_block.body)
+            .map_err(|e| ResignError::new(format!("malformed original inbound network block: {e}")))?;
+        let edited_network_block: NetworkBlock = from_cbor_no_leftovers(&edited_block.body)
+            .map_err(|e| ResignError::new(format!("malformed inbound network block: {e}")))?;
+        let body_was_edited = original_block.body != edited_block.body;
+        let original_header = original_network_block
+            .decode_header()
+            .map_err(|e| ResignError::new(format!("malformed original inbound block header: {e}")))?;
+        let edited_header = edited_network_block
+            .decode_header()
+            .map_err(|e| ResignError::new(format!("malformed edited inbound block header: {e}")))?;
+        if body_was_edited && original_header != edited_header {
+            return Err(ResignError::new(
+                "an inbound block-body edit may not change the producer header; use the pre-announced signed header",
+            ));
+        }
+        let (rewritten, used_mapping) = self.rewrite_blockfetch_block_inner(edited_network_block, request)?;
+        if body_was_edited && !used_mapping {
+            return Err(ResignError::new(
+                "an inbound block-body edit requires a pre-announced signed header with the edited body commitment",
+            ));
+        }
+        if to_cbor(&rewritten) == edited_block.body {
+            return Ok(edited.to_vec());
+        }
+        Ok(to_cbor(&blockfetch::Message::from(blockfetch::Block { body: to_cbor(&rewritten) })))
+    }
+
+    /// Substitute the signed edited header into a producer's otherwise unchanged block.
+    ///
+    /// This is the typed BlockFetch receive boundary used by the production initiator. It either
+    /// returns one internally consistent block or an error; callers must not forward the original
+    /// block after an error.
+    pub fn rewrite_blockfetch_block(&self, network_block: NetworkBlock) -> Result<NetworkBlock, ResignError> {
+        self.rewrite_blockfetch_block_inner(network_block, None).map(|(block, _)| block)
+    }
+
+    fn rewrite_blockfetch_block_inner(
+        &self,
+        network_block: NetworkBlock,
+        request: Option<BlockFetchRequest>,
+    ) -> Result<(NetworkBlock, bool), ResignError> {
+        let original_header = network_block
+            .decode_header()
+            .map_err(|e| ResignError::new(format!("malformed inbound block header: {e}")))?;
+        let original_point = NetworkPoint::Specific(original_header.slot(), original_header.hash());
+        let decoded_block = network_block
+            .decode_block()
+            .map_err(|e| ResignError::new(format!("could not compute returned block body commitment: {e}")))?;
+        let actual_body_hash = decoded_block.body_hash();
+        let actual_body_size = u32::try_from(decoded_block.body_len())
+            .map_err(|_| ResignError::new("returned block body size does not fit the header field"))?;
+        if request.as_ref().is_some_and(|request| !request.complete) {
+            return Err(ResignError::new(
+                "the request-bound edited branch is incomplete because an expected mapping is no longer available",
+            ));
+        }
+        let required_requested_point =
+            request.as_ref().and_then(|request| request.expected.get(&original_point)).copied();
+        if request.is_some() && required_requested_point.is_none() {
+            return Ok((network_block, false));
+        }
+        let mappings = self.mappings.lock();
+        let mut active_requests = self.active_requests.lock();
+        let mut consumed = if let Some(required) = required_requested_point {
+            let request_id = request
+                .as_ref()
+                .filter(|request| request.request_id != 0)
+                .map(|request| request.request_id)
+                .ok_or_else(|| {
+                    ResignError::new("a request-bound pre-announced signed header has no active request identity")
+                })?;
+            let activity = active_requests.get_mut(&request_id).ok_or_else(|| {
+                ResignError::new(
+                    "the request-bound pre-announced signed header belongs to a request that is no longer active",
+                )
+            })?;
+            if activity.scope != request.as_ref().map_or("", |request| request.scope.as_str()) {
+                return Err(ResignError::new("the active BlockFetch request identity does not match its typed scope"));
+            }
+            if activity.consumed.contains(&required) {
+                return Err(ResignError::new(
+                    "the request-bound pre-announced signed header was already consumed by this request",
+                ));
+            }
+            Some(&mut activity.consumed)
+        } else {
+            None
+        };
+        let mut saw_original_point = false;
+        let mut candidates = Vec::new();
+        for (edited_point, mapping) in mappings.iter().filter(|(_, mapping)| mapping.original == original_point) {
+            saw_original_point = true;
+            let signed_header: Header = decode_header("mapped signed", &mapping.signed_header)?;
+            if signed_header.body().block_body_hash == actual_body_hash
+                && signed_header.body().block_body_size == actual_body_size
+                && required_requested_point.is_none_or(|required| required == *edited_point)
+            {
+                candidates.push((*edited_point, mapping.clone()));
+            }
+        }
+        if !saw_original_point {
+            if required_requested_point.is_some() {
+                return Err(ResignError::new(format!(
+                    "the request-bound pre-announced signed header for original point {original_point:?} is no longer available"
+                )));
+            }
+            return Ok((network_block, false));
+        }
+        let (edited_point, mapping) = match candidates.len() {
+            1 => candidates
+                .pop()
+                .ok_or_else(|| ResignError::new("exact BlockFetch mapping disappeared during selection"))?,
+            0 => {
+                return Err(ResignError::new(format!(
+                    "no request-bound pre-announced signed header for original point {original_point:?} matches the returned block body hash {actual_body_hash} and body size {actual_body_size}"
+                )));
+            }
+            _ => {
+                return Err(ResignError::new(format!(
+                    "ambiguous pre-announced signed headers for original point {original_point:?}, returned block body hash {actual_body_hash}, and body size {actual_body_size}; an exact requested edited point is required"
+                )));
+            }
+        };
+        let rewritten_body = replace_block_header(&to_cbor(&network_block), &mapping.signed_header)?;
+        let rewritten: NetworkBlock = from_cbor_no_leftovers(&rewritten_body)
+            .map_err(|e| ResignError::new(format!("rewritten network block is malformed: {e}")))?;
+        if rewritten.decode_header().map_err(|e| ResignError::new(e.to_string()))?.hash() != edited_point.hash() {
+            return Err(ResignError::new("rewritten block does not contain the mapped signed header"));
+        }
+        if let Some(consumed) = &mut consumed {
+            consumed.insert(edited_point);
+        }
+        Ok((rewritten, true))
+    }
+}
+
+impl Resigner {
+    pub fn new(enabled: bool, config: Option<PathBuf>) -> Self {
+        Self { enabled: AtomicBool::new(enabled), config }
+    }
+
+    pub fn enabled(&self) -> bool {
+        self.enabled.load(Ordering::SeqCst)
+    }
+
+    pub fn set_enabled(&self, enabled: bool) -> Result<(), ResignError> {
+        if enabled && self.config.is_none() {
+            return Err(ResignError::new(
+                "controlled_devnet_signing_unavailable: re-signing is unavailable outside a controlled Freeze devnet",
+            ));
+        }
+        self.enabled.store(enabled, Ordering::SeqCst);
+        Ok(())
+    }
+
+    pub fn resign_header(&self, original: &[u8], edited: &[u8]) -> Result<Option<SignedHeader>, ResignError> {
+        if original == edited || !self.enabled() {
+            return Ok(None);
+        }
+
+        let original_header: Header = decode_header("original", original)?;
+        let edited_header: Header = decode_header("edited", edited)?;
+        protect_consensus_inputs(&original_header, &edited_header)?;
+
+        let config_root =
+            self.config.as_deref().ok_or_else(|| ResignError::new("missing controlled-devnet configuration mount"))?;
+        let body = edited_header.body();
+        let config = matching_producer_config(config_root, body.vrf_verification_key.as_slice())?;
+        let genesis_path = config.join("configs/shelley-genesis.json");
+        let genesis: serde_json::Value = serde_json::from_slice(
+            &fs::read(&genesis_path)
+                .map_err(|e| ResignError::new(format!("missing {}: {e}", genesis_path.display())))?,
+        )
+        .map_err(|e| ResignError::new(format!("malformed {}: {e}", genesis_path.display())))?;
+        let slots_per_kes_period = genesis
+            .get("slotsPerKESPeriod")
+            .and_then(serde_json::Value::as_u64)
+            .filter(|n| *n > 0)
+            .ok_or_else(|| ResignError::new("Shelley genesis has no positive slotsPerKESPeriod"))?;
+        let max_kes_evolutions = genesis
+            .get("maxKESEvolutions")
+            .and_then(serde_json::Value::as_u64)
+            .ok_or_else(|| ResignError::new("Shelley genesis has no maxKESEvolutions"))?;
+
+        let pool_id = Hasher::<{ 8 * POOL_COLD_KEY }>::hash(body.issuer_verification_key.as_slice()).to_string();
+        if genesis.pointer(&format!("/staking/pools/{pool_id}")).is_none() {
+            return Err(ResignError::new(format!("header issuer pool {pool_id} is not in the mounted genesis")));
+        }
+
+        let vrf_raw =
+            Zeroizing::new(read_envelope(&config.join("keys/vrf.skey"), "VrfSigningKey_PraosVRF", VRF_SECRET_BYTES)?);
+        let vrf_seed: &[u8; 32] =
+            vrf_raw[..32].try_into().map_err(|_| ResignError::new("VRF signing seed is not 32 bytes"))?;
+        let vrf_secret = vrf::SecretKey::from(vrf_seed);
+        let vrf_public = vrf::PublicKey::from(&vrf_secret);
+        if vrf_public.as_ref() != &vrf_raw[32..] {
+            return Err(ResignError::new("VRF signing envelope public suffix does not match its seed"));
+        }
+        if vrf_public.as_ref() != body.vrf_verification_key.as_slice() {
+            return Err(ResignError::new("mounted VRF key does not match the header identity"));
+        }
+
+        let mounted_opcert = read_opcert(&config.join("keys/opcert.cert"))?;
+        if mounted_opcert.issuer.as_slice() != body.issuer_verification_key.as_slice() {
+            return Err(ResignError::new("mounted operational certificate issuer does not match the header"));
+        }
+        if mounted_opcert.certificate != body.operational_cert {
+            return Err(ResignError::new("mounted operational certificate does not match the header"));
+        }
+        verify_opcert(&mounted_opcert.certificate, &mounted_opcert.issuer)?;
+
+        let kes_raw = read_envelope(&config.join("keys/kes.skey"), "KesSigningKey_ed25519_kes_2^6", KES_BYTES)?;
+        let mut kes_secret = kes::SecretKey::from_bytes(kes_raw)
+            .map_err(|e| ResignError::new(format!("malformed 608-byte KES signing key: {e}")))?;
+        let kes_public = kes::PublicKey::from(&mut kes_secret);
+        if kes_public.as_ref() != body.operational_cert.operational_cert_kes_verification_key.as_slice() {
+            return Err(ResignError::new("mounted KES key does not match the operational certificate hot key"));
+        }
+
+        let absolute_period = body.slot / slots_per_kes_period;
+        let start = u64::from(body.operational_cert.operational_cert_kes_period);
+        let relative_period = absolute_period
+            .checked_sub(start)
+            .ok_or_else(|| ResignError::new("header slot precedes the operational certificate KES start period"))?;
+        if relative_period >= max_kes_evolutions {
+            return Err(ResignError::new(format!(
+                "relative KES period {relative_period} is outside maxKESEvolutions {max_kes_evolutions}"
+            )));
+        }
+        let relative_period: u32 =
+            relative_period.try_into().map_err(|_| ResignError::new("relative KES period does not fit in u32"))?;
+        for _ in 0..relative_period {
+            kes_secret
+                .update()
+                .map_err(|e| ResignError::new(format!("could not evolve KES key to period {relative_period}: {e}")))?;
+        }
+        if kes_secret.period() != KesEvolution::from(relative_period) {
+            return Err(ResignError::new("KES key evolution ended at the wrong period"));
+        }
+
+        let preimage = to_cbor(body);
+        let signature = kes_secret.sign(&preimage);
+        signature
+            .verify(KesEvolution::from(relative_period), &kes_public, &preimage)
+            .map_err(|e| ResignError::new(format!("generated KES signature did not verify: {e}")))?;
+        let signature_bytes: [u8; 448] = (&signature).into();
+        let signed_bytes = replace_signature(edited, &signature_bytes)?;
+        let signed_header: Header = decode_header("signed", &signed_bytes)?;
+        let emitted_signature = kes::Signature::try_from(signed_header.signature().as_slice())
+            .map_err(|_| ResignError::new("emitted KES signature has the wrong length"))?;
+        emitted_signature
+            .verify(KesEvolution::from(relative_period), &kes_public, &to_cbor(signed_header.body()))
+            .map_err(|e| ResignError::new(format!("emitted KES signature did not verify: {e}")))?;
+
+        Ok(Some(SignedHeader {
+            bytes: signed_bytes,
+            original_hash: original_header.hash(),
+            signed_hash: signed_header.hash(),
+        }))
+    }
+}
+
+fn matching_producer_config(root: &std::path::Path, expected_vrf: &[u8]) -> Result<PathBuf, ResignError> {
+    let mut candidates = if root.join("keys").is_dir() && root.join("configs").is_dir() {
+        vec![root.to_path_buf()]
+    } else {
+        let entries = fs::read_dir(root).map_err(|e| {
+            ResignError::new(format!("missing controlled-devnet producer directory {}: {e}", root.display()))
+        })?;
+        let mut directories = entries
+            .filter_map(Result::ok)
+            .map(|entry| entry.path())
+            .filter(|path| path.is_dir() && path.join("keys").is_dir() && path.join("configs").is_dir())
+            .collect::<Vec<_>>();
+        directories.sort();
+        directories
+    };
+    if candidates.is_empty() {
+        return Err(ResignError::new(format!(
+            "controlled-devnet producer directory {} contains no producer configurations",
+            root.display()
+        )));
+    }
+    for config in candidates.drain(..) {
+        let vrf_raw =
+            Zeroizing::new(read_envelope(&config.join("keys/vrf.skey"), "VrfSigningKey_PraosVRF", VRF_SECRET_BYTES)?);
+        let seed: &[u8; 32] =
+            vrf_raw[..32].try_into().map_err(|_| ResignError::new("VRF signing seed is not 32 bytes"))?;
+        let secret = vrf::SecretKey::from(seed);
+        let public = vrf::PublicKey::from(&secret);
+        if public.as_ref() != &vrf_raw[32..] {
+            return Err(ResignError::new("VRF signing envelope public suffix does not match its seed"));
+        }
+        if public.as_ref() == expected_vrf {
+            return Ok(config);
+        }
+    }
+    Err(ResignError::new("no mounted producer VRF key matches the header identity"))
+}
+
+fn decode_header(label: &str, bytes: &[u8]) -> Result<Header, ResignError> {
+    from_cbor_no_leftovers(bytes).map_err(|e| ResignError::new(format!("malformed {label} header: {e}")))
+}
+
+fn decode_message<T>(label: &str, bytes: &[u8]) -> Result<T, ResignError>
+where
+    for<'b> T: cbor::Decode<'b, ()>,
+{
+    from_cbor_no_leftovers(bytes).map_err(|e| ResignError::new(format!("malformed {label} message: {e}")))
+}
+
+fn protect_consensus_inputs(original: &Header, edited: &Header) -> Result<(), ResignError> {
+    let before = original.body();
+    let after = edited.body();
+    if before.slot != after.slot {
+        return Err(ResignError::new(
+            "slot_vrf_eligibility_unproven: slot is protected because changing it requires a new Praos VRF proof",
+        ));
+    }
+    if before.issuer_verification_key != after.issuer_verification_key {
+        return Err(ResignError::new("issuer_identity_change_forbidden: issuer verification key is protected"));
+    }
+    if before.vrf_verification_key != after.vrf_verification_key {
+        return Err(ResignError::new("vrf_identity_change_forbidden: VRF verification key is protected"));
+    }
+    if before.vrf_result != after.vrf_result {
+        return Err(ResignError::new("vrf_leader_proof_regeneration_unavailable: VRF proof and output are protected"));
+    }
+    if before.operational_cert != after.operational_cert {
+        return Err(ResignError::new(
+            "operational_certificate_cold_key_unavailable: operational certificate is protected",
+        ));
+    }
+    Ok(())
+}
+
+#[derive(Deserialize)]
+struct TextEnvelope {
+    #[serde(rename = "type")]
+    kind: String,
+    #[serde(rename = "cborHex")]
+    cbor_hex: String,
+}
+
+fn read_envelope(path: &std::path::Path, expected_kind: &str, expected_len: usize) -> Result<Vec<u8>, ResignError> {
+    let encoded = fs::read(path).map_err(|e| ResignError::new(format!("missing {}: {e}", path.display())))?;
+    let envelope: TextEnvelope =
+        serde_json::from_slice(&encoded).map_err(|e| ResignError::new(format!("malformed {}: {e}", path.display())))?;
+    if envelope.kind != expected_kind {
+        return Err(ResignError::new(format!(
+            "{} has type {}, expected {expected_kind}",
+            path.display(),
+            envelope.kind
+        )));
+    }
+    let cbor = hex::decode(&envelope.cbor_hex)
+        .map_err(|e| ResignError::new(format!("malformed cborHex in {}: {e}", path.display())))?;
+    let mut decoder = cbor::Decoder::new(&cbor);
+    // Cardano text envelopes use one canonical, definite CBOR byte string. Reject an
+    // indefinite string instead of accepting a different key-file representation.
+    #[allow(clippy::disallowed_methods)]
+    let raw = decoder.bytes().map_err(|e| {
+        ResignError::new(format!("{} does not contain a definite CBOR byte string: {e}", path.display()))
+    })?;
+    if decoder.position() != cbor.len() {
+        return Err(ResignError::new(format!("{} has trailing CBOR data", path.display())));
+    }
+    if raw.len() != expected_len {
+        return Err(ResignError::new(format!(
+            "{} contains {} key bytes, expected {expected_len}",
+            path.display(),
+            raw.len()
+        )));
+    }
+    Ok(raw.to_vec())
+}
+
+struct MountedOpCert {
+    certificate: OperationalCert,
+    issuer: VerificationKey,
+}
+
+fn read_opcert(path: &std::path::Path) -> Result<MountedOpCert, ResignError> {
+    let encoded = fs::read(path).map_err(|e| ResignError::new(format!("missing {}: {e}", path.display())))?;
+    let envelope: TextEnvelope =
+        serde_json::from_slice(&encoded).map_err(|e| ResignError::new(format!("malformed {}: {e}", path.display())))?;
+    if envelope.kind != "NodeOperationalCertificate" {
+        return Err(ResignError::new(format!("{} is not a NodeOperationalCertificate", path.display())));
+    }
+    let bytes = hex::decode(&envelope.cbor_hex)
+        .map_err(|e| ResignError::new(format!("malformed cborHex in {}: {e}", path.display())))?;
+    let mut decoder = cbor::Decoder::new(&bytes);
+    exact_array(&mut decoder, 2, "operational certificate envelope")?;
+    exact_array(&mut decoder, 4, "operational certificate")?;
+    let hot = fixed_bytes::<32>(&mut decoder, "operational certificate hot key")?;
+    let sequence = decoder.u64().map_err(|e| ResignError::new(format!("malformed opcert sequence: {e}")))?;
+    let start = decoder.u64().map_err(|e| ResignError::new(format!("malformed opcert KES start: {e}")))?;
+    let sigma = fixed_bytes::<64>(&mut decoder, "operational certificate signature")?;
+    let issuer = fixed_bytes::<32>(&mut decoder, "operational certificate issuer")?;
+    if decoder.position() != bytes.len() {
+        return Err(ResignError::new("operational certificate has trailing CBOR data"));
+    }
+    Ok(MountedOpCert {
+        certificate: OperationalCert {
+            operational_cert_kes_verification_key: hot,
+            operational_cert_sequence_number: sequence,
+            operational_cert_kes_period: start.into(),
+            operational_cert_sigma: sigma,
+        },
+        issuer,
+    })
+}
+
+fn exact_array(decoder: &mut cbor::Decoder<'_>, expected: u64, name: &str) -> Result<(), ResignError> {
+    let actual = decoder.array().map_err(|e| ResignError::new(format!("malformed {name}: {e}")))?;
+    if actual != Some(expected) {
+        return Err(ResignError::new(format!("{name} has array length {actual:?}, expected {expected}")));
+    }
+    Ok(())
+}
+
+fn fixed_bytes<const N: usize>(decoder: &mut cbor::Decoder<'_>, name: &str) -> Result<FixedBytes<N>, ResignError> {
+    // Operational-certificate fields are canonical definite byte strings on disk.
+    #[allow(clippy::disallowed_methods)]
+    let bytes = decoder.bytes().map_err(|e| ResignError::new(format!("malformed {name}: {e}")))?;
+    FixedBytes::try_from(bytes).map_err(|e| ResignError::new(format!("malformed {name}: {e}")))
+}
+
+fn verify_opcert(certificate: &OperationalCert, issuer_bytes: &VerificationKey) -> Result<(), ResignError> {
+    let issuer = ed25519::VerifyingKey::try_from(issuer_bytes.as_slice())
+        .map_err(|e| ResignError::new(format!("malformed operational certificate issuer: {e}")))?;
+    let signature = ed25519::Signature::try_from(certificate.operational_cert_sigma.as_slice())
+        .map_err(|e| ResignError::new(format!("malformed operational certificate signature: {e}")))?;
+    let mut message = Vec::with_capacity(48);
+    message.extend_from_slice(certificate.operational_cert_kes_verification_key.as_slice());
+    message.extend_from_slice(&certificate.operational_cert_sequence_number.to_be_bytes());
+    message.extend_from_slice(&u64::from(certificate.operational_cert_kes_period).to_be_bytes());
+    issuer
+        .verify_strict(&message, &signature)
+        .map_err(|_| ResignError::new("operational certificate cold signature is invalid"))
+}
+
+fn replace_signature(edited: &[u8], signature: &[u8; 448]) -> Result<Vec<u8>, ResignError> {
+    let mut decoder = cbor::Decoder::new(edited);
+    exact_array(&mut decoder, 2, "header")?;
+    decoder.skip().map_err(|e| ResignError::new(format!("malformed header body: {e}")))?;
+    let body_end = decoder.position();
+    decoder.skip().map_err(|e| ResignError::new(format!("malformed header signature: {e}")))?;
+    if decoder.position() != edited.len() {
+        return Err(ResignError::new("edited header has trailing CBOR data"));
+    }
+    let mut bytes = edited[..body_end].to_vec();
+    cbor::Encoder::new(&mut bytes)
+        .bytes(signature)
+        .map_err(|e| ResignError::new(format!("could not encode KES signature: {e}")))?;
+    Ok(bytes)
+}
+
+fn replace_block_header(network_block: &[u8], signed_header: &[u8]) -> Result<Vec<u8>, ResignError> {
+    let mut decoder = cbor::Decoder::new(network_block);
+    exact_array(&mut decoder, 2, "network block")?;
+    decoder.skip().map_err(|e| ResignError::new(format!("malformed network block era: {e}")))?;
+    exact_array(&mut decoder, 5, "block")?;
+    let header_start = decoder.position();
+    decoder.skip().map_err(|e| ResignError::new(format!("malformed block header: {e}")))?;
+    let header_end = decoder.position();
+    for _ in 0..4 {
+        decoder.skip().map_err(|e| ResignError::new(format!("malformed block body: {e}")))?;
+    }
+    if decoder.position() != network_block.len() {
+        return Err(ResignError::new("network block has trailing CBOR data"));
+    }
+    let mut rewritten = Vec::with_capacity(network_block.len() - (header_end - header_start) + signed_header.len());
+    rewritten.extend_from_slice(&network_block[..header_start]);
+    rewritten.extend_from_slice(signed_header);
+    rewritten.extend_from_slice(&network_block[header_end..]);
+    Ok(rewritten)
+}
