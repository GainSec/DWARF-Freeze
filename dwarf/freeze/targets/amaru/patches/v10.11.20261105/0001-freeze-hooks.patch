+#[test]
+fn a_debugger_controls_every_step_of_a_running_stage_graph() {
+    let agent = Agent::new(json!({ "kind": "test" }), None, true);
+    assert!(amaru_freeze::install(agent.clone()));
+    let mut events = agent.subscribe();
+
+    let rt = tokio::runtime::Runtime::new().unwrap();
+    let mut graph = TokioBuilder::default();
+    let validate = graph.stage("validate", async |mut ledger: Ledger, msg: Msg, eff| {
+        match msg {
+            Msg::Pay { to, fee } => {
+                amaru_freeze::probe!("test.stage.pay", { "fee": fee });
+                ledger.seen += 1;
+                eff.send(&ledger.out, Out::Paid { to, fee, seen: ledger.seen }).await;
+            }
+            Msg::FromPeer(message) => {
+                let heard = eff.external(FreezeProtoEffect { message }).await;
+                eff.send(&ledger.out, Out::Heard(heard)).await;
+            }
+            Msg::Nap(ms) => {
+                let before = eff.clock().await;
+                let after = eff.wait(Duration::from_millis(ms)).await;
+                let perceived_ms = after.saturating_since(before).as_millis() as u64;
+                eff.send(&ledger.out, Out::Napped { perceived_ms }).await;
+            }
+        }
+        ledger
+    });
+    let (out_ref, mut out) = graph.output("output", 10);
+    let validate = graph.wire_up(validate, Ledger { seen: 0, out: out_ref });
+    let input = graph.input(&validate);
+
+    let bench = graph.stage("bench", async |mut bench: Bench, job: Job, eff| {
+        match job {
+            Job::Wait(ms) => {
+                let before = eff.clock().await;
+                let after = eff.wait(Duration::from_millis(ms)).await;
+                let perceived_ms = after.saturating_since(before).as_millis() as u64;
+                eff.send(&bench.out, Done::Waited { perceived_ms }).await;
+            }
+            Job::Timeout(ms) => {
+                eff.set_timeout(Duration::from_millis(ms), Job::Fired("timeout".into())).await;
+                eff.send(&bench.out, Done::Armed).await;
+            }
+            Job::Schedule(ms) => {
+                let id = eff.schedule_after(Job::Fired("schedule".into()), Duration::from_millis(ms)).await;
+                bench.scheduled = Some(id);
+                eff.send(&bench.out, Done::Armed).await;
+            }
+            Job::Call(ms) => {
+                let answer = eff.call(&bench.mute, Duration::from_millis(ms), Ask).await;
+                eff.send(&bench.out, Done::Called { answered: answer.is_some() }).await;
+            }
+            Job::Shout(text) => {
+                let shouted = eff.external(Echo { text }).await;
+                eff.send(&bench.out, Done::Fired(shouted)).await;
+            }
+            Job::Fired(what) => eff.send(&bench.out, Done::Fired(what)).await,
+            Job::Cancel => {
+                let cancelled = match bench.scheduled.take() {
+                    Some(id) => eff.cancel_schedule(id).await,
+                    None => false,
+                };
+                eff.send(&bench.out, Done::Cancelled(cancelled)).await;
+            }
+        }
+        bench
+    });
+    let mute = graph.stage("mute", async |mut kept: Vec<Ask>, ask: Ask, _eff| {
+        kept.push(ask);
+        kept
+    });
+    let (done_ref, mut done) = graph.output("done", 10);
+    let mute = graph.wire_up(mute, Vec::new());
+    let bench = graph.wire_up(bench, Bench { out: done_ref, mute: mute.without_state(), scheduled: None });
+    let jobs = graph.input(&bench);
+
+    let (echo_ref, mut echo_done) = graph.output("echo-output", 2);
+    let echoer = graph.stage("echoer", async |out: StageRef<Done>, text: String, eff| {
+        let echoed = eff.external(Echo { text }).await;
+        eff.send(&out, Done::Fired(echoed)).await;
+        out
+    });
+    let echoer = graph.wire_up(echoer, echo_ref);
+    let echo_input = graph.input(&echoer);
+
+    let handle = rt.handle().clone();
+    rt.block_on(async move {
+        let graph = graph.run(handle);
+        let pay = |to: &str, fee| Msg::Pay { to: to.into(), fee };
+
+        // Hold an input, edit it, then edit what the stage sends on.
+        input.send(pay("alice", 301_204)).await.unwrap();
+        let item = held(&agent, &mut events, "internal_input", "validate").await;
+        assert_eq!(item["payload"], json!({ "Pay": { "to": "alice", "fee": 301_204 } }));
+        assert_eq!(item["label"], "Msg");
