+};
+
+/// The standard names of the node-to-node mini-protocols, by protocol number.
+fn protocol_number(id: &str) -> Option<u16> {
+    id.parse::<u16>().ok().map(|number| number & !0x8000)
+}
+
+fn protocol_name(id: &str) -> &'static str {
+    match protocol_number(id) {
+        Some(0) => "handshake",
+        Some(2) => "chain sync",
+        Some(3) => "block fetch",
+        Some(4) => "tx submission",
+        Some(8) => "keep alive",
+        Some(10) => "peer sharing",
+        _ => "protocol",
+    }
+}
+
+/// Which peer each connection's multiplexer talks to, so protocol items can name their peer.
+static PEERS: LazyLock<Mutex<BTreeMap<String, String>>> = LazyLock::new(Default::default);
+static RESIGNING: LazyLock<Coordinator> = LazyLock::new(Coordinator::new);
+
+fn edit_refusal(protocol: &str, original: &[u8], candidate: &[u8]) -> Option<ResignError> {
+    (protocol_number(protocol) == Some(4) && original != candidate).then(|| {
+        ResignError::new(
+            "tx_witness_material_unavailable: TxSubmission edits require an exact signer ownership map and mounted payment witness keys",
+        )
+    })
+}
