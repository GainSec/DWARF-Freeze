+#[test]
+fn coordinator_selects_the_exact_commitment_among_mappings_for_one_original_point() {
+    let mut fixture = Fixture::new(0);
+    let seed = Header::new(fixture.body.clone(), KesSignature::zeroes());
+    let original_block = make_block_with_header(&seed);
+    fixture.body = original_block.header.body().clone();
+    let original_network_block = NetworkBlock::new(&EraHistory::default(), &original_block).unwrap();
+    let original_header = to_cbor(&original_block.header);
+    let original = chain_message(&original_header, original_block.header.hash(), &fixture.body);
+
+    let mut edited_blocks = Vec::new();
+    let coordinator = Coordinator::new();
+    let resigner = Resigner::new(true, Some(fixture.directory.path().into()));
+    for fee_delta in [1, 2] {
+        let mut edited_block = original_block.clone();
+        let original_tx = &original_block.transaction_bodies[0];
+        edited_block.transaction_bodies[0] =
+            TransactionBody::new(original_tx.inputs.clone(), original_tx.outputs.clone(), original_tx.fee + fee_delta);
+        let network_block = NetworkBlock::new(&EraHistory::default(), &edited_block).unwrap();
+        let decoded = network_block.decode_block().unwrap();
+        let mut committed_body = fixture.body.clone();
+        committed_body.block_body_hash = decoded.body_hash();
+        committed_body.block_body_size = decoded.body_len().try_into().unwrap();
+        let edited = chain_message(&fixture.header(&committed_body), original_block.header.hash(), &fixture.body);
+        let signed: chainsync::Message = from_cbor_no_leftovers(
+            &coordinator
+                .chain_sync(&resigner, ChainSyncDirection::Inbound, "chain", "peer", &original, &edited)
+                .unwrap(),
+        )
+        .unwrap();
+        let signed_header = match signed {
+            chainsync::Message::RollForward(content, _) => from_cbor_no_leftovers::<Header>(&content.cbor).unwrap(),
+            other => panic!("unexpected message: {other:?}"),
+        };
+        edited_blocks.push((signed_header, network_block));
+    }
+    edited_blocks.sort_by_key(|(header, _)| NetworkPoint::Specific(header.slot(), header.hash()));
+    let (expected_header, selected_block) = edited_blocks.pop().unwrap();
+
+    let original_response =
+        to_cbor(&blockfetch::Message::from(blockfetch::Block { body: to_cbor(&original_network_block) }));
+    let edited_response = to_cbor(&blockfetch::Message::from(blockfetch::Block { body: to_cbor(&selected_block) }));
+    let rewritten_response = coordinator.blockfetch_in("peer", &original_response, &edited_response).unwrap();
+    let rewritten_message: blockfetch::Message = from_cbor_no_leftovers(&rewritten_response).unwrap();
+    let blockfetch::Message::Block(rewritten) = rewritten_message else {
+        panic!("expected a BlockFetch block response")
+    };
+    let rewritten: NetworkBlock = from_cbor_no_leftovers(&rewritten.body).unwrap();
+
+    assert_eq!(rewritten.decode_header().unwrap(), expected_header);
+    assert_eq!(coordinator.pending("peer"), 2, "request-local consumption must retain both global mappings");
+}
