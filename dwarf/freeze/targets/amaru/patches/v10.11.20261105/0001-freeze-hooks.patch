+#[derive(Debug, Clone, PartialEq, serde::Serialize, serde::Deserialize)]
+enum Msg {
+    Pay { to: String, fee: u64 },
+    Nap(u64),
+    FromPeer(Vec<u8>),
+}
+
+/// Stands in for the effect a protocol stage uses to offer network messages to the agent:
+/// a stage may only wait on effects, so the wait for the debugger happens inside one.
+#[derive(Debug, PartialEq, serde::Serialize, serde::Deserialize)]
+struct FreezeProtoEffect {
+    message: Vec<u8>,
+}
+
+impl ExternalEffectAPI for FreezeProtoEffect {
+    type Response = Option<Vec<u8>>;
+
+    fn run(self: Box<Self>, _resources: Resources) -> BoxFuture<'static, Box<dyn SendData>> {
+        self.wrap(|this| async move {
+            let agent = amaru_freeze::agent().expect("installed by the test");
+            let item = BytesItem {
+                kind: "proto_in",
+                from: "peer:10.0.0.12:3001".into(),
+                to: "stage:validate-1".into(),
+                type_name: "ouroboros/2".into(),
+                label: "chain sync".into(),
+                cold_spots: vec!["cbor-decode"],
+                bytes: &this.message,
+                is_cbor: true,
+                parent: amaru_freeze::trace::context("validate-1").0,
+                cause: 0,
+            };
+            let (seq, verdict) = gate_bytes(agent, item).await;
+            amaru_freeze::trace::set_context("validate-1", item_parent(), seq);
+            match verdict {
+                BytesVerdict::Forward => Some(this.message),
+                BytesVerdict::Drop => None,
+                BytesVerdict::Replace(bytes) | BytesVerdict::ReplaceStale(bytes) => Some(bytes),
+            }
+        })
+    }
+}
+
+fn item_parent() -> u64 {
+    amaru_freeze::trace::context("validate-1").0
+}
+
+#[derive(Debug, Clone, PartialEq, serde::Serialize, serde::Deserialize)]
+enum Out {
+    Paid { to: String, fee: u64, seen: u64 },
+    Napped { perceived_ms: u64 },
+    Heard(Option<Vec<u8>>),
+}
+
+#[derive(Debug, Clone, PartialEq, serde::Serialize, serde::Deserialize)]
+struct Ledger {
+    seen: u64,
+    out: StageRef<Out>,
+}
+
+/// What the stage that exercises the remaining effects is asked to do.
+#[derive(Debug, Clone, PartialEq, serde::Serialize, serde::Deserialize)]
+enum Job {
+    Wait(u64),
+    Timeout(u64),
+    Schedule(u64),
+    Call(u64),
+    Shout(String),
+    Fired(String),
+    /// Cancel the schedule armed last, by the id the stage was given for it.
+    Cancel,
+}
+
+#[derive(Debug, Clone, PartialEq, serde::Serialize, serde::Deserialize)]
+enum Done {
+    Waited { perceived_ms: u64 },
+    Armed,
+    Fired(String),
+    Called { answered: bool },
+    Cancelled(bool),
+}
+
+/// A call that is never answered: the callee keeps the reply address and stays silent.
+#[derive(Debug, Clone, PartialEq, serde::Serialize, serde::Deserialize)]
+struct Ask(StageRef<u64>);
+
+#[derive(Debug, Clone, PartialEq, serde::Serialize, serde::Deserialize)]
+struct Bench {
+    out: StageRef<Done>,
+    mute: StageRef<Ask>,
+    scheduled: Option<ScheduleId>,
+}
+
+#[derive(Debug, PartialEq, serde::Serialize, serde::Deserialize)]
+struct Echo {
+    text: String,
+}
+
+impl ExternalEffectAPI for Echo {
+    type Response = String;
+
+    fn run(self: Box<Self>, _resources: Resources) -> BoxFuture<'static, Box<dyn SendData>> {
+        self.wrap(|this| async move { this.text.to_uppercase() })
+    }
+}
+
+/// Forward what a stage does until its effect with the wanted label is held, and return it.
+async fn held_effect(agent: &Agent, events: &mut Receiver<Arc<str>>, party: &str, label: &str) -> Json {
+    loop {
+        let item = held(agent, events, "internal_action", party).await;
+        if item["label"] == label {
+            return item;
+        }
+        agent.step(item["seq"].as_u64()).unwrap();
+    }
+}
+
+async fn completed(events: &mut Receiver<Arc<str>>, seq: u64) -> Json {
+    loop {
+        let line = timeout(Duration::from_secs(5), events.recv()).await.expect("an event").unwrap();
+        let event: Json = amaru_freeze::serde_json::from_str(&line).unwrap();
+        if event["event"] == "item.done" && event["data"]["seq"] == seq {
+            return event["data"]["outcome"].clone();
+        }
+    }
+}
+
+/// Forward held items until one of the wanted kind and destination is held, and return it.
+async fn held(agent: &Agent, events: &mut Receiver<Arc<str>>, kind: &str, party: &str) -> Json {
+    loop {
+        let line = timeout(Duration::from_secs(5), events.recv()).await.expect("an event").unwrap();
+        let event: Json = amaru_freeze::serde_json::from_str(&line).unwrap();
+        if event["event"] != "item" || event["data"]["held"] != true {
+            continue;
+        }
+        let item = &event["data"];
+        // An item that a thaw released since it was announced is no longer anyone's to decide.
+        if !agent.status()["held"].as_array().unwrap().contains(&item["seq"]) {
+            continue;
+        }
+        let matches = item["kind"] == kind
+            && (item["to"].as_str().unwrap().contains(party) || item["from"].as_str().unwrap().contains(party));
+        if matches {
+            return item.clone();
+        }
+        agent.step(item["seq"].as_u64()).unwrap();
+    }
+}
