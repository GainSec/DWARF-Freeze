+        assert_eq!(store.load_header(&fork.hash()), Some(fork.clone()));
+
+        // What was read is accepted as it is; `valid: null` takes the flag away.
+        let mut edited = stored.clone();
+        edited["valid"] = Json::Null;
+        put(&agent, &format!("chain/headers/{}", fork.hash()), &edited).unwrap();
+        assert_eq!(get(&agent, &format!("chain/headers/{key}")).unwrap()["valid"], Json::Null);
+        let raw = json!({ "header": { "$bytes": hex::encode(to_cbor(&fork)) } });
+        put(&agent, &format!("chain/headers/{key}"), &raw).unwrap();
+
+        let elsewhere = make_header(7, 60, None);
+        let mismatch = put(&agent, &format!("chain/headers/{}", elsewhere.hash()), &value).unwrap_err();
+        assert!(mismatch.contains("the key names") && mismatch.contains("\"force\": true"), "{mismatch}");
+        assert!(!store.has_header(&elsewhere.hash()));
+        let other_slot = format!("{:020}-{}", 56, fork.hash());
+        assert!(put(&agent, &format!("chain/headers/{other_slot}"), &value).unwrap_err().contains("another slot"));
+        let flagged = json!({ "header": value["header"], "valid": "yes" });
+        assert!(put(&agent, &format!("chain/headers/{key}"), &flagged).unwrap_err().contains("`valid`"));
+        assert!(put(&agent, &format!("chain/headers/{key}"), &json!({ "header": [1] })).is_err());
+
+        let forced = json!({ "header": value["header"], "force": true });
+        put(&agent, &format!("chain/headers/{}", elsewhere.hash()), &forced).unwrap();
+        assert!(store.has_header(&elsewhere.hash()), "the header is stored under a hash that is not its own");
+
+        delete(&agent, &format!("chain/headers/{key}")).unwrap();
+        assert_eq!(get(&agent, &format!("chain/headers/{key}")), None);
+        assert!(!store.get_children(&blocks[3].header.hash()).contains(&fork.hash()));
+        assert_eq!(store_writes(&agent).len(), 5);
+        assert_eq!(store_writes(&agent)[4], ("chain/headers".to_string(), key, "delete".to_string()));
+    }
