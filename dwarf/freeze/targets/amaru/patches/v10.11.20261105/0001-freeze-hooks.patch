+//! Re-signs edited headers only with the producer identity mounted by a Freeze devnet.
+
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    fmt, fs,
+    path::PathBuf,
+    sync::atomic::{AtomicBool, AtomicU64, Ordering},
+};
+
+use amaru_kernel::{
+    Hasher, Header, HeaderHash, IsHeader, KesEvolution, NetworkPoint, OperationalCert, Point, VerificationKey,
+    cardano::{fixed_bytes::FixedBytes, network_block::NetworkBlock},
+    cbor, ed25519, from_cbor_no_leftovers,
