+/// Gets an idle ledger thread to run its [`BetweenRequests`] hook, without keeping that thread alive.
+#[derive(Clone)]
+pub struct LedgerWaker {
+    sender: Weak<Mutex<Option<mpsc::Sender<LedgerRequest>>>>,
+    /// Whether a wake-up is already waiting in the request queue. Keeping it to one leaves the
+    /// queue's bound to the producers it was sized for.
+    waking: Arc<AtomicBool>,
+}
+
+impl LedgerWaker {
+    /// Returns false if the ledger thread has terminated or stopped taking requests. A thread that is too busy to take the
+    /// request runs the hook anyway, before the next request in its queue.
+    pub fn wake(&self) -> bool {
+        let Some(sender) = self.sender.upgrade() else {
+            return false;
+        };
+        let sender = sender.lock();
+        let Some(sender) = sender.as_ref() else {
