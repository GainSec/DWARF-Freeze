+/// Owns one responder request identity for exactly as long as the stage is serving it.
+/// Dropping the in-flight future on timeout, disconnect, or supervisor cancellation releases the
+/// coordinator lease just like BatchDone, NoBlocks, and every explicit error return.
+struct ResponderRequestLease {
+    request: BlockFetchRequest,
+    #[cfg(test)]
+    lease_id: u64,
+}
+
+#[cfg(test)]
+static NEXT_RESPONDER_LEASE_ID: AtomicU64 = AtomicU64::new(1);
+#[cfg(test)]
+static STARTED_RESPONDER_LEASE_ID: AtomicU64 = AtomicU64::new(0);
+#[cfg(test)]
+static FINISHED_RESPONDER_LEASE_ID: AtomicU64 = AtomicU64::new(0);
+
+impl ResponderRequestLease {
+    fn new(request: BlockFetchRequest) -> Self {
+        #[cfg(test)]
+        let lease_id = {
+            let lease_id = NEXT_RESPONDER_LEASE_ID.fetch_add(1, Ordering::SeqCst);
+            STARTED_RESPONDER_LEASE_ID.store(lease_id, Ordering::SeqCst);
+            lease_id
+        };
+        Self {
+            request,
+            #[cfg(test)]
+            lease_id,
+        }
+    }
+}
+
+impl Deref for ResponderRequestLease {
+    type Target = BlockFetchRequest;
+
+    fn deref(&self) -> &Self::Target {
+        &self.request
+    }
+}
+
+impl Drop for ResponderRequestLease {
+    fn drop(&mut self) {
+        freeze::finish_blockfetch_request(&self.request);
+        #[cfg(test)]
+        FINISHED_RESPONDER_LEASE_ID.store(self.lease_id, Ordering::SeqCst);
+    }
+}
+
+#[cfg(test)]
+fn started_responder_lease_id() -> u64 {
+    STARTED_RESPONDER_LEASE_ID.load(Ordering::SeqCst)
+}
+
+#[cfg(test)]
+fn finished_responder_lease_id() -> u64 {
+    FINISHED_RESPONDER_LEASE_ID.load(Ordering::SeqCst)
+}
