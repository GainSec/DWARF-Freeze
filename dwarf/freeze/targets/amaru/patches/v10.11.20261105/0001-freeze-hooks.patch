+    #[test]
+    fn ledger_writes_wait_for_the_ledger_thread() {
+        let (_dir, config, node, inputs, outputs) = ledger_of_three_outputs();
+        let agent = Agent::new(json!({}), None, true);
+        let mut events = agent.subscribe();
+        let writes = register_ledger(&agent, &config);
+        let pots = json!({ "treasury": 5, "reserves": 6, "fees": 7, "donations": 8 });
+
+        assert_eq!(put(&agent, "ledger/pots", &pots), Err("the ledger thread is not taking writes".into()));
+        let mut apply = writes.applier(node.share());
+        let woken = Arc::new(AtomicBool::new(false));
+        writes.woken_by({
+            let woken = woken.clone();
+            move || woken.store(true, Ordering::SeqCst)
+        });
+        agent.thaw();
+        assert_eq!(put(&agent, "ledger/pots", &pots), Err(NOT_FROZEN.into()));
+        agent.freeze();
+
+        // A write is only queued: nothing changes until the ledger thread gets to it.
+        put(&agent, "ledger/pots", &pots).unwrap();
+        assert!(woken.load(Ordering::SeqCst));
+        assert_eq!(get(&agent, "ledger/pots").unwrap()["treasury"], 11);
+        assert_eq!(store_writes(&agent), vec![]);
+        apply(&Blocks(Vec::new()));
+        assert_eq!(get(&agent, "ledger/pots"), Some(pots.clone()));
+        assert!(put(&agent, "ledger/pots/pots", &json!({ "treasury": 1 })).unwrap_err().contains("`reserves`"));
+        assert!(put(&agent, "ledger/pots/kitty", &pots).unwrap_err().contains("has no `kitty`"));
+        assert!(delete(&agent, "ledger/pots/pots").unwrap_err().contains("replaced but not deleted"));
+
+        // An output is added, replaced by what the read side showed with one change, and removed.
+        let added = format!("{}#7", "04".repeat(32));
+        put(&agent, &format!("ledger/utxo/{added}"), &cbor_json(&output(None, 99))).unwrap();
+        let existing = utxo_key(&inputs[0]);
+        let raw = json!({ "$bytes": hex::encode(to_cbor(&output(Some([6u8; 28]), 1_000))) });
+        put(&agent, &format!("ledger/utxo/{existing}"), &raw).unwrap();
+        delete(&agent, &format!("ledger/utxo/{}", utxo_key(&inputs[1]))).unwrap();
+        apply(&Blocks(Vec::new()));
+        assert_eq!(get(&agent, &format!("ledger/utxo/{added}")), Some(cbor_json(&output(None, 99))));
+        assert_eq!(get(&agent, &format!("ledger/utxo/{existing}")), Some(cbor_json(&output(Some([6u8; 28]), 1_000))));
+        assert_eq!(get(&agent, &format!("ledger/utxo/{}", utxo_key(&inputs[1]))), None);
+        assert_eq!(get(&agent, &format!("ledger/utxo/{}", utxo_key(&inputs[2]))), Some(cbor_json(&outputs[2])));
+        assert_eq!(get(&agent, "ledger/stake/none"), Some(json!({ "lovelace": 149 })));
+        assert_eq!(get(&agent, &format!("ledger/stake/key-{}", "06".repeat(28))), Some(json!({ "lovelace": 1_000 })));
+        assert!(
+            put(&agent, &format!("ledger/utxo/{added}"), &json!([1, 2])).unwrap_err().contains("transaction output")
+        );
+        assert!(put(&agent, "ledger/utxo/nonsense", &raw).is_err());
+
+        // Removing an output that is not there is found out by the ledger thread, and logged.
+        delete(&agent, &format!("ledger/utxo/{}#9", "04".repeat(32))).unwrap();
+        apply(&Blocks(Vec::new()));
+
+        let mut parameters = PREPROD_DEFAULT_PROTOCOL_PARAMETERS.clone();
+        parameters.max_block_body_size += 1;
+        put(&agent, "ledger/params/protocol_parameters", &cbor_json(&parameters)).unwrap();
+        apply(&Blocks(Vec::new()));
+        assert_eq!(get(&agent, "ledger/params"), Some(cbor_json(&parameters)));
+        assert!(put(&agent, "ledger/params", &json!({ "max_block_body_size": 1 })).is_err());
+
+        assert_eq!(get(&agent, "ledger/tip").unwrap()["slot"], 42, "the tip does not move");
+        let written = |namespace: &str, key: &str, op: &str| (namespace.to_string(), key.to_string(), op.to_string());
+        assert_eq!(
+            store_writes(&agent),
+            vec![
+                written("ledger/pots", "pots", "put"),
+                written("ledger/utxo", &added, "put"),
+                written("ledger/utxo", &existing, "put"),
+                written("ledger/utxo", &utxo_key(&inputs[1]), "delete"),
+                written("ledger/params", "protocol_parameters", "put"),
+            ]
+        );
+        let mut failures = Vec::new();
+        while let Ok(line) = events.try_recv() {
+            let event: Json = serde_json::from_str(&line).unwrap();
+            if event["event"] == "log" {
+                failures.push(event["data"]["message"].as_str().unwrap().to_string());
+            }
+        }
+        assert_eq!(failures.len(), 1, "{failures:?}");
+        assert!(failures[0].starts_with(&format!("store write to ledger/utxo/{}#9 failed", "04".repeat(32))));
+        assert!(failures[0].contains("no such unspent output"), "{failures:?}");
+
+        let (provider, key) = agent.state("ledger/pots").unwrap();
+        assert_eq!(provider.receipt(&key)["queued"], true);
+
+        // The node's own handle on the store is as usable as before.
+        let transaction = node.create_transaction();
+        transaction.commit().unwrap();
+        drop(apply);
+        drop(node);
+    }
