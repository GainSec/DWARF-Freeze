+/// Mark a place as a probe of the freeze agent, on the targets the agent is built for; see
+/// `amaru_freeze::probe!`. Fields are `"name": value` pairs, evaluated only while a debugger
+/// has the probe switched on.
+///
+/// With `verdict = result` in place of the fields, the probe evaluates to `result` after
+/// reporting the text of its error, if any, as the field `error`.
+#[cfg(all(not(target_family = "wasm"), not(target_arch = "riscv32")))]
+macro_rules! probe {
+    ($name:literal, verdict = $verdict:expr) => {{
+        let verdict = $verdict;
+        amaru_freeze::probe!($name, { "error": amaru_freeze::probes::error_text(&verdict) });
+        verdict
+    }};
+    ($name:literal $(, { $($key:literal : $value:expr),* $(,)? })?) => {
+        amaru_freeze::probe!($name, { $($($key: $value),*)? })
+    };
+}
+
+#[cfg(not(all(not(target_family = "wasm"), not(target_arch = "riscv32"))))]
+macro_rules! probe {
+    ($name:literal, verdict = $verdict:expr) => {
+        $verdict
+    };
+    ($name:literal $(, { $($key:literal : $value:expr),* $(,)? })?) => {{
+        $(let _ = || {
+            $(let _ = &$value;)*
+        };)?
+    }};
+}
