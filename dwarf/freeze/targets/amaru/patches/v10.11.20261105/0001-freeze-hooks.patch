+        let call = held_effect(&agent, &mut events, "bench", "call").await;
+        assert_eq!(call["payload"], json!({ "timeout_ms": 60_000 }));
+        assert_eq!((&call["editable"], &call["droppable"]), (&json!(true), &json!(false)));
+        assert!(agent.resolve(call["seq"].as_u64().unwrap(), Verdict::Drop).is_err());
+        agent.resolve(call["seq"].as_u64().unwrap(), Verdict::Replace(json!({ "timeout_ms": 200 }))).unwrap();
+        agent.thaw();
+        assert_eq!(timeout(Duration::from_secs(5), done.next()).await.unwrap(), Some(Done::Called { answered: false }));
+
+        // The fields of an effect outside the stage graph are edited before it runs.
+        agent.freeze();
+        jobs.send(Job::Shout("hello".into())).await.unwrap();
+        let echo = held_effect(&agent, &mut events, "bench", "Echo").await;
+        assert_eq!(echo["payload"], json!({ "text": "hello" }));
+        assert_eq!((&echo["editable"], &echo["droppable"]), (&json!(true), &json!(false)));
+        agent.resolve(echo["seq"].as_u64().unwrap(), Verdict::Replace(json!({ "text": "edited" }))).unwrap();
+        agent.thaw();
+        assert_eq!(timeout(Duration::from_secs(2), done.next()).await.unwrap(), Some(Done::Fired("EDITED".into())));
+
+        agent.freeze();
+        jobs.send(Job::Wait(100)).await.unwrap();
+        let wait = held_effect(&agent, &mut events, "bench", "wait").await;
+        let wait_seq = wait["seq"].as_u64().unwrap();
+        agent.resolve(wait_seq, Verdict::Replace(json!({ "ms": "soon" }))).unwrap();
+        let refusal = completed(&mut events, wait_seq).await;
+        assert_eq!(refusal["status"], "rejected");
+        assert_eq!(refusal["code"], "edit_reconstruction_failed");
+        agent.thaw();
+        assert_eq!(timeout(Duration::from_secs(2), done.next()).await.unwrap(), Some(Done::Waited { perceived_ms: 0 }));
+
+        agent.freeze();
+        input.send(pay("dave", 5)).await.unwrap();
+        let item = held(&agent, &mut events, "internal_input", "validate").await;
+        let input_seq = item["seq"].as_u64().unwrap();
+        let raw_error = agent.resolve(input_seq, Verdict::ReplaceRaw(vec![0x01])).unwrap_err();
+        assert!(raw_error.contains("typed_raw_replacement_unsupported"));
+        assert_eq!(agent.status()["held"], json!([input_seq]));
+        agent.resolve(input_seq, Verdict::Replace(json!({ "Pay": { "to": "dave" } }))).unwrap();
+        let refusal = completed(&mut events, input_seq).await;
+        assert_eq!(refusal["status"], "rejected");
+        assert_eq!(refusal["code"], "edit_reconstruction_failed");
+        agent.thaw();
+        assert!(!matches!(timeout(Duration::from_millis(300), out.next()).await, Ok(Some(_))));
+
+        agent.freeze();
+        echo_input.send("hello".to_string()).await.unwrap();
+        let echo = held_effect(&agent, &mut events, "echoer", "Echo").await;
+        agent.step(echo["seq"].as_u64()).unwrap();
+        let result = held(&agent, &mut events, "internal_result", "echoer").await;
+        let result_seq = result["seq"].as_u64().unwrap();
+        let raw_error = agent.resolve(result_seq, Verdict::ReplaceRawStale(vec![0x01])).unwrap_err();
+        assert!(raw_error.contains("typed_raw_replacement_unsupported"));
+        assert_eq!(agent.status()["held"], json!([result_seq]));
+        agent.resolve(result_seq, Verdict::Replace(json!(7))).unwrap();
+        let refusal = completed(&mut events, result_seq).await;
+        assert_eq!(refusal["status"], "rejected");
+        assert_eq!(refusal["code"], "edit_reconstruction_failed");
+        agent.thaw();
+        assert!(!matches!(timeout(Duration::from_millis(300), echo_done.next()).await, Ok(Some(_))));
+
+        graph.abort();
+    });
+}
