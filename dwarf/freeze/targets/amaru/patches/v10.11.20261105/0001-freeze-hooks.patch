+//! Makes the chain store and the ledger store readable and writable by a debugger attached to
+//! the freeze agent.
+//!
+//! The chain store is the one the node itself uses, for reads and for writes. The ledger store
+//! belongs to the ledger thread: each read opens its own read-only view of it and sees what had
+//! been written to disk at that moment, and each write is queued for the ledger thread, which
+//! applies it between two of its requests in a transaction of its own. The blocks the ledger
+//! holds in memory past its stored tip also belong to the ledger thread, which is asked for them
+//! the same way and answers between two of its requests.
+//!
+//! Writes are refused unless the node is frozen, and each one that was applied is recorded as a
+//! `store_write` item. A write that the node's own rules would never have produced is refused
+//! unless it says `"unsafe": true`, and is recorded as such.
+
+use std::{
+    collections::{BTreeMap, VecDeque},
+    str::FromStr,
+    sync::{
+        Arc, Weak,
+        atomic::{AtomicBool, Ordering},
+        mpsc,
+    },
+    time::Duration,
+};
+
+use amaru_consensus::block_validator::{BetweenRequests, LedgerView};
+use amaru_freeze::{
+    Agent, Draft, StateProvider,
+    wire::{cbor_payload, payload_to_cbor},
+};
+use amaru_kernel::{
+    BlockHeight, CertificatePointer, Credential, Header, HeaderHash, IsHeader, MemoizedTransactionOutput, ORIGIN_HASH,
+    Point, PoolId, Pots, ProtocolParameters, RawBlock, Slot, TransactionInput, TransactionPointer, cbor,
+    from_cbor_no_leftovers, to_cbor,
+};
+use amaru_ledger::{
+    state::volatile::AnchoredVolatileFragment,
+    store::{ReadStore, Store, StoreError, TransactionalContext, columns::accounts},
+};
+use amaru_ouroboros::{BaseReadChainStore, ChainStore};
+use amaru_stores::rocksdb::{ReadOnlyRocksDB, RocksDB, RocksDbConfig};
+use parking_lot::Mutex;
+use serde_json::{Value as Json, json};
+
+/// Register the chain and ledger namespaces with the freeze agent, if this process is being debugged.
+///
+/// The ledger namespaces accept writes once the returned queue has been given to the ledger thread.
+pub fn register(chain_store: Arc<dyn ChainStore>, ledger_store: &RocksDbConfig) -> Option<LedgerWrites> {
+    let agent = amaru_freeze::agent()?;
+    register_chain(agent, chain_store);
+    Some(register_ledger(agent, ledger_store))
+}
+
+fn register_chain(agent: &Arc<Agent>, store: Arc<dyn ChainStore>) {
+    for family in [ChainFamily::Best, ChainFamily::Headers, ChainFamily::Blocks, ChainFamily::Nonces] {
+        let state = ChainState { agent: Arc::downgrade(agent), store: store.clone(), family };
+        agent.register_state(family.namespace(), Arc::new(state));
+    }
+}
+
+fn register_ledger(agent: &Arc<Agent>, config: &RocksDbConfig) -> LedgerWrites {
+    let writes = LedgerWrites {
+        queue: Arc::new(LedgerQueue {
+            agent: Arc::downgrade(agent),
+            pending: Mutex::new(VecDeque::new()),
+            questions: Mutex::new(VecDeque::new()),
+            attached: AtomicBool::new(false),
+            wake: Mutex::new(None),
+        }),
+    };
+    for family in [
+        LedgerFamily::Tip,
+        LedgerFamily::Pots,
+        LedgerFamily::Params,
+        LedgerFamily::Utxo,
+        LedgerFamily::Stake,
+        LedgerFamily::Accounts,
+    ] {
+        let state = LedgerState { config: config.clone(), family, writes: writes.clone() };
+        agent.register_state(family.namespace(), Arc::new(state));
+    }
+    let volatile = VolatileState { writes: writes.clone(), answer_within: LEDGER_THREAD_PATIENCE };
+    agent.register_state(VOLATILE_NAMESPACE, Arc::new(volatile));
+    writes
+}
+
+fn read_only<T>(namespace: &str) -> Result<T, String> {
+    Err(format!("{namespace} is read-only"))
+}
+
+/// The agent, provided the node is frozen: a store is only written to while nothing else moves.
+fn frozen(agent: &Weak<Agent>) -> Result<Arc<Agent>, String> {
+    let agent = agent.upgrade().ok_or("the freeze agent is gone")?;
+    if agent.is_frozen() { Ok(agent) } else { Err("stores are only written to while the node is frozen".to_string()) }
+}
+
+fn note_write(agent: &Agent, namespace: &str, key: &str, op: &str) {
+    agent.note(Draft {
+        kind: "store_write",
+        label: namespace.to_string(),
+        payload: json!({ "key": key, "op": op }),
+        ..Draft::default()
+    });
+}
+
+/// What a debugger is told about a write the node's own rules would never have produced.
+const UNSAFE_WARNING: &str = "the node's later behaviour is evidence of nothing but this edit";
+
+/// Record a write that was only accepted because it said `"unsafe": true`.
+fn note_unsafe_write(agent: &Agent, namespace: &str, key: &str, op: &str) {
+    agent.note(Draft {
+        kind: "store_write",
+        label: namespace.to_string(),
+        payload: json!({ "key": key, "op": op, "unsafe": true, "warning": UNSAFE_WARNING }),
+        ..Draft::default()
+    });
+}
+
+/// Whether a written value owns up to leaving the node in a state its rules never produce.
+fn owned_up_to(namespace: &str, value: &Json) -> Result<(), String> {
+    if value.get("unsafe").and_then(Json::as_bool).unwrap_or(false) {
+        Ok(())
+    } else {
+        Err(format!("{namespace} is only written with `\"unsafe\": true` in the value: {UNSAFE_WARNING}"))
+    }
+}
+
+/// Whether a written value asks for the checks that tie a key to its content to be skipped.
+fn forced(value: &Json) -> bool {
+    value.get("force").and_then(Json::as_bool).unwrap_or(false)
+}
+
+/// The bytes of one CBOR item given the way the read side shows it: decoded, as tagged JSON, or
+/// raw, as `{"$bytes": "<hex>"}` holding the encoded item.
+fn cbor_bytes(value: &Json) -> Result<Vec<u8>, String> {
+    if let Some(object) = value.as_object()
+        && object.len() == 1
+        && let Some(Json::String(encoded)) = object.get("$bytes")
+    {
+        return hex::decode(encoded).map_err(|error| format!("bad $bytes: {error}"));
+    }
+    payload_to_cbor(value)
+}
+
+fn decoded<T: for<'d> cbor::Decode<'d, ()>>(what: &str, value: &Json) -> Result<T, String> {
+    from_cbor_no_leftovers(&cbor_bytes(value)?).map_err(|error| format!("not a valid {what}: {error}"))
+}
+
+fn entry(key: impl Into<String>, value: Json) -> Json {
+    json!({ "key": key.into(), "value": value })
+}
+
+/// The entries of a small, fully known namespace that `list` was asked for.
+fn page(entries: Vec<(&str, Json)>, prefix: &str, after: Option<&str>, limit: usize) -> Vec<Json> {
+    entries
+        .into_iter()
+        .filter(|(key, _)| key.starts_with(prefix) && after.is_none_or(|after| *key > after))
+        .take(limit)
+        .map(|(key, value)| entry(key, value))
+        .collect()
+}
+
+fn cbor_json<T: cbor::Encode<()>>(value: &T) -> Json {
+    let bytes = to_cbor(value);
+    cbor_payload(&bytes).unwrap_or_else(|| json!({ "$bytes": hex::encode(&bytes) }))
+}
+
+fn serde_json_of<T: serde::Serialize>(value: &T) -> Result<Json, String> {
+    serde_json::to_value(value).map_err(|error| error.to_string())
+}
+
+#[derive(Clone, Copy)]
+enum ChainFamily {
+    Best,
+    Headers,
+    Blocks,
+    Nonces,
+}
+
+impl ChainFamily {
+    fn namespace(self) -> &'static str {
+        match self {
+            ChainFamily::Best => "chain/best",
+            ChainFamily::Headers => "chain/headers",
+            ChainFamily::Blocks => "chain/blocks",
+            ChainFamily::Nonces => "chain/nonces",
+        }
+    }
+}
+
+/// One family of chain store content, read from and written to the store the node itself uses.
+struct ChainState {
+    agent: Weak<Agent>,
+    store: Arc<dyn ChainStore>,
+    family: ChainFamily,
+}
+
+fn chain_point(point: &Point) -> Json {
+    json!({
+        "slot": point.slot_or_default().as_u64(),
+        "hash": point.hash().to_string(),
+        "height": point.block_height().as_u64(),
+    })
+}
+
+/// Zero-padded slot, then header hash, so that keys sort in chain order.
+fn chain_key(point: &Point) -> String {
+    format!("{:020}-{}", point.slot_or_default().as_u64(), point.hash())
+}
+
+/// The slot, if the key carries one, and the header hash of a full key or of a bare hash.
+fn parse_chain_key(key: &str) -> Result<(Option<Slot>, HeaderHash), String> {
+    let (slot, hash) = match key.rsplit_once('-') {
+        Some((slot, hash)) => {
+            (Some(Slot::from(slot.parse::<u64>().map_err(|_| format!("bad slot in key `{key}`"))?)), hash)
+        }
+        None => (None, key),
+    };
+    let hash = HeaderHash::from_str(hash).map_err(|error| format!("bad header hash in key `{key}`: {error}"))?;
+    Ok((slot, hash))
+}
+
+/// A point given as `chain/best` shows it: `{"slot": .., "hash": "..", "height": ..}`.
+fn parse_chain_point(value: &Json) -> Result<Point, String> {
+    let number = |field: &str| value.get(field).and_then(Json::as_u64).ok_or(format!("needs a number `{field}`"));
+    let hash = value.get("hash").and_then(Json::as_str).ok_or("needs a text `hash`")?;
+    let hash = HeaderHash::from_str(hash).map_err(|error| format!("bad header hash `{hash}`: {error}"))?;
+    let (slot, height) = (number("slot")?, number("height")?);
+    if hash == ORIGIN_HASH && slot == 0 && height == 0 {
+        return Ok(Point::Origin);
+    }
+    Ok(Point::Specific(Slot::from(slot), hash, BlockHeight::from(height)))
+}
+
+/// The header as it is stored under `hash` although its content hashes to something else.
+fn readdressed(header: &Header, hash: &HeaderHash) -> Result<Header, String> {
+    let mut fields = serde_json_of(header)?;
+    fields["hash"] = serde_json_of(hash)?;
+    serde_json::from_value(fields).map_err(|error| format!("cannot store the header under {hash}: {error}"))
+}
+
+const FORCE_HINT: &str = "add `\"force\": true` to write it anyway";
+const STORE_BLOCK_REPAIR_UNAVAILABLE: &str = "store_block_repair_unavailable";
+const STORE_BLOCK_HEADER_NOT_PREEXISTING: &str = "store_block_header_not_preexisting";
+
+fn header_summary(point: &Point, header: Option<&Header>) -> Json {
+    json!({
+        "slot": point.slot_or_default().as_u64(),
+        "height": point.block_height().as_u64(),
+        "hash": point.hash().to_string(),
+        "parent": header.and_then(|header| header.parent()).map(|parent| parent.to_string()),
+    })
+}
+
+impl ChainState {
+    fn value(&self, store: &dyn BaseReadChainStore, point: &Point) -> Result<Json, String> {
+        let hash = point.hash();
+        Ok(match self.family {
+            ChainFamily::Best => Json::Null,
+            ChainFamily::Headers => header_summary(point, store.load_header(&hash).as_ref()),
+            ChainFamily::Blocks => {
+                let block = store.load_block(&hash).map_err(|error| error.to_string())?;
+                json!({
+                    "slot": point.slot_or_default().as_u64(),
+                    "hash": hash.to_string(),
+                    "stored": block.is_some(),
+                    "bytes": block.map(|block| block.len()),
+                })
+            }
+            ChainFamily::Nonces => match store.get_nonces(&hash) {
+                Some(nonces) => serde_json_of(&nonces)?,
+                None => Json::Null,
+            },
+        })
+    }
+
+    /// Walk the best chain from the anchor, oldest first.
+    fn walk(&self, prefix: &str, after: Option<&str>, limit: usize) -> Result<Vec<Json>, String> {
+        let store = self.store.snapshot();
+        let mut entries = Vec::new();
+        let mut point = match after {
+            None => {
+                let anchor = store.get_anchor_point();
+                // The anchor is the oldest block of the chain, unless the chain starts at genesis.
+                if anchor != Point::Origin && limit > 0 && chain_key(&anchor).starts_with(prefix) {
+                    entries.push(entry(chain_key(&anchor), self.value(&*store, &anchor)?));
+                }
+                anchor
+            }
+            Some(after) => {
+                let (slot, hash) = parse_chain_key(after)?;
+                let point = match (store.load_point(&hash), slot) {
+                    (Some(point), _) => point,
+                    (None, Some(slot)) => Point::Specific(slot, hash, BlockHeight::from(0)),
+                    (None, None) => return Err(format!("no header `{after}`")),
+                };
+                if point != Point::Origin && !store.is_on_best_chain(point.into()) {
+                    return Err(format!("`{after}` is not on the best chain"));
+                }
+                point
+            }
+        };
+        while entries.len() < limit {
+            let Some(next) = store.next_best_chain(&point) else {
+                break;
+            };
+            let key = chain_key(&next);
+            if key.starts_with(prefix) {
+                entries.push(entry(key, self.value(&*store, &next)?));
+            }
+            point = next;
+        }
+        Ok(entries)
+    }
+
+    fn best(&self) -> Vec<(&'static str, Json)> {
+        let store = self.store.snapshot();
+        vec![("anchor", chain_point(&store.get_anchor_point())), ("tip", chain_point(&store.get_best_chain_tip()))]
+    }
+
+    /// Move the tip or the anchor. Only the pointer moves: the headers between the old and the
+    /// new one are neither added to nor removed from the best chain.
+    fn put_best(&self, key: &str, value: &Json) -> Result<(), String> {
+        let point = parse_chain_point(value)?;
+        if !forced(value) && point != Point::Origin {
+            let stored = self.store.load_point(&point.hash());
+            let same = stored.is_some_and(|stored| {
+                stored.slot_or_default() == point.slot_or_default() && stored.block_height() == point.block_height()
+            });
+            if !same {
+                let found = stored.map_or("no such header is stored".to_string(), |stored| {
+                    format!("the stored header is at {}", chain_point(&stored))
+                });
+                return Err(format!("{} does not name a stored header ({found}); {FORCE_HINT}", chain_point(&point)));
+            }
+        }
+        match key {
+            "tip" => self.store.set_best_chain_tip(&point),
+            "anchor" => self.store.set_anchor_point(&point),
+            _ => return Err(format!("chain/best has `tip` and `anchor`, not `{key}`")),
+        }
+        .map_err(|error| error.to_string())
+    }
+
+    fn put_header(&self, key: &str, value: &Json) -> Result<(), String> {
+        let (slot, hash) = parse_chain_key(key)?;
+        let header: Header = decoded("header", value.get("header").ok_or("needs `header`: the header as CBOR")?)?;
+        let valid = match value.get("valid") {
+            None => None,
+            Some(Json::Null) => Some(None),
+            Some(Json::Bool(valid)) => Some(Some(*valid)),
+            Some(_) => return Err("`valid` must be true, false or null".to_string()),
+        };
+        if !forced(value) {
+            if header.hash() != hash {
+                return Err(format!("the key names {hash} but the header hashes to {}; {FORCE_HINT}", header.hash()));
+            }
+            if slot.is_some_and(|slot| slot != header.slot()) {
+                return Err(format!("the key names another slot than the header's, {}; {FORCE_HINT}", header.slot()));
+            }
+        }
+        let header = if header.hash() == hash { header } else { readdressed(&header, &hash)? };
+        self.store.store_header(&header).map_err(|error| error.to_string())?;
+        match valid {
+            None => Ok(()),
+            Some(None) => self.store.remove_block_valid(&hash),
+            Some(Some(valid)) => self.store.set_block_valid(&hash, valid),
+        }
+        .map_err(|error| error.to_string())
+    }
+
+    fn put_block(&self, key: &str, value: &Json) -> Result<(), String> {
+        let (slot, hash) = parse_chain_key(key)?;
+        if !forced(value) && value.get("repair").and_then(Json::as_bool).unwrap_or(false) {
+            return Err(format!(
+                "{STORE_BLOCK_REPAIR_UNAVAILABLE}: chain/blocks has no mux/request identity and cannot atomically store a repaired header with its body; pre-store the exact validated header or use explicit `force` negative-control mode"
+            ));
+        }
+        let bytes = cbor_bytes(value.get("block").ok_or("needs `block`: {\"$bytes\": \"<the block as hex CBOR>\"}")?)?;
+        let block = RawBlock::from(&bytes[..]);
+        if !forced(value) {
+            let header = block.decode_header().map_err(|error| format!("not a valid block: {error}; {FORCE_HINT}"))?;
+            if header.hash() != hash {
+                return Err(format!(
+                    "the key names {hash} but the block's header hashes to {}; {FORCE_HINT}",
+                    header.hash()
+                ));
+            }
+            if slot.is_some_and(|slot| slot != header.slot()) {
+                return Err(format!("the key names another slot than the block's, {}; {FORCE_HINT}", header.slot()));
+            }
+            match self.store.load_header(&hash) {
+                Some(stored) if stored == header => {}
+                Some(_) => {
+                    return Err(format!(
+                        "{STORE_BLOCK_HEADER_NOT_PREEXISTING}: the stored header under {hash} is not byte-semantically identical to the block header; {FORCE_HINT}"
+                    ));
+                }
+                None => {
+                    return Err(format!(
+                        "{STORE_BLOCK_HEADER_NOT_PREEXISTING}: store the exact validated header {hash} before its block body; chain/blocks cannot make that pair atomic; {FORCE_HINT}"
+                    ));
+                }
+            }
+            let body = block.decode().map_err(|error| format!("not a valid block: {error}; {FORCE_HINT}"))?.body_hash();
+            if body != header.body().block_body_hash {
+                return Err(format!(
+                    "the block's body hashes to {body} but its header claims {}; {FORCE_HINT}",
+                    header.body().block_body_hash
+                ));
+            }
+        }
+        self.store.store_block(&hash, &block).map_err(|error| error.to_string())
+    }
+}
+
+impl StateProvider for ChainState {
+    fn list(&self, prefix: &str, after: Option<&str>, limit: usize) -> Result<Vec<Json>, String> {
+        match self.family {
+            ChainFamily::Best => Ok(page(self.best(), prefix, after, limit)),
+            ChainFamily::Headers | ChainFamily::Blocks | ChainFamily::Nonces => self.walk(prefix, after, limit),
+        }
+    }
+
+    fn get(&self, key: &str) -> Result<Option<Json>, String> {
+        if let ChainFamily::Best = self.family {
+            return Ok(if key.is_empty() {
+                Some(Json::Object(self.best().into_iter().map(|(name, point)| (name.to_string(), point)).collect()))
+            } else {
+                self.best().into_iter().find(|(name, _)| *name == key).map(|(_, point)| point)
+            });
+        }
+        let (_, hash) = parse_chain_key(key)?;
+        match self.family {
+            ChainFamily::Best => Ok(None),
+            ChainFamily::Headers => Ok(self.store.load_header_with_validity(&hash).map(|(header, valid)| {
+                let mut value = header_summary(&header.point(), Some(&header));
+                value["valid"] = json!(valid);
+                value["header"] = cbor_json(&header);
+                value
+            })),
+            ChainFamily::Blocks => {
+                let Some(block) = self.store.load_block(&hash).map_err(|error| error.to_string())? else {
+                    return Ok(None);
+                };
+                let slot = match self.store.load_header(&hash) {
+                    Some(header) => Some(header.slot().as_u64()),
+                    None => block.decode_header().ok().map(|header| header.slot().as_u64()),
+                };
+                Ok(Some(
+                    json!({ "slot": slot, "hash": hash.to_string(), "block": { "$bytes": hex::encode(&block[..]) } }),
+                ))
+            }
+            ChainFamily::Nonces => self.store.get_nonces(&hash).map(|nonces| serde_json_of(&nonces)).transpose(),
+        }
+    }
+
+    fn put(&self, key: &str, value: &Json) -> Result<(), String> {
+        if let ChainFamily::Nonces = self.family {
+            return read_only(self.family.namespace());
+        }
+        let agent = frozen(&self.agent)?;
+        match self.family {
+            ChainFamily::Best => self.put_best(key, value)?,
+            ChainFamily::Headers => self.put_header(key, value)?,
+            ChainFamily::Blocks => self.put_block(key, value)?,
+            ChainFamily::Nonces => {}
+        }
+        note_write(&agent, self.family.namespace(), key, "put");
+        Ok(())
+    }
+
+    fn delete(&self, key: &str) -> Result<(), String> {
+        match self.family {
+            ChainFamily::Nonces => return read_only(self.family.namespace()),
+            ChainFamily::Best => {
+                return Err("a chain always has a tip and an anchor: put another one in its place".to_string());
+            }
+            ChainFamily::Headers | ChainFamily::Blocks => {}
+        }
+        let agent = frozen(&self.agent)?;
+        let (_, hash) = parse_chain_key(key)?;
+        match self.family {
+            ChainFamily::Headers => self.store.delete_header(&hash),
+            ChainFamily::Blocks => self.store.delete_block(&hash),
+            ChainFamily::Best | ChainFamily::Nonces => Ok(()),
+        }
+        .map_err(|error| error.to_string())?;
+        note_write(&agent, self.family.namespace(), key, "delete");
+        Ok(())
+    }
+}
+
+/// A change to the ledger store, checked and waiting for the ledger thread to apply it.
+enum LedgerWrite {
+    PutUtxo(TransactionInput, Box<MemoizedTransactionOutput>),
+    DeleteUtxo(TransactionInput),
+    Pots(Pots),
+    Params(Box<ProtocolParameters>),
+    Account(Credential, accounts::Row),
+}
+
+impl LedgerWrite {
+    /// Whether the write was only accepted because it said `"unsafe": true`.
+    fn is_unsafe(&self) -> bool {
+        matches!(self, LedgerWrite::Account(..))
+    }
+}
+
+/// A question about the blocks the ledger holds in memory, for the ledger thread to answer.
+enum VolatileQuestion {
+    List { prefix: String, after: Option<String>, limit: usize },
+    Get(String),
+}
+
+struct QueuedQuestion {
+    question: VolatileQuestion,
+    answer: mpsc::SyncSender<Result<Json, String>>,
+}
+
+struct QueuedWrite {
+    namespace: &'static str,
+    key: String,
+    write: LedgerWrite,
+}
+
+struct LedgerQueue {
+    agent: Weak<Agent>,
+    pending: Mutex<VecDeque<QueuedWrite>>,
+    questions: Mutex<VecDeque<QueuedQuestion>>,
+    /// Whether the ledger thread has been given the means to apply what is queued.
+    attached: AtomicBool,
+    wake: Mutex<Option<Box<dyn Fn() + Send + Sync>>>,
+}
+
+/// The writes a debugger asked for on the ledger store and its questions about the ledger's
+/// in-memory state, on their way to the ledger thread.
+#[derive(Clone)]
+pub struct LedgerWrites {
+    queue: Arc<LedgerQueue>,
+}
+
+impl LedgerWrites {
+    /// What the ledger thread runs between two of its requests to apply the queued writes and
+    /// then answer the queued questions.
+    ///
+    /// `store` is a handle on the ledger thread's own store, see [`RocksDB::share`]. Each write is
+    /// one transaction; a write that fails is reported to the debugger and leaves the store as it was.
+    pub fn applier(&self, store: RocksDB) -> BetweenRequests {
+        let queue = self.queue.clone();
+        queue.attached.store(true, Ordering::SeqCst);
+        Box::new(move |ledger: &dyn LedgerView| {
+            while let Some(queued) = queue.pop_write() {
+                let Some(agent) = queue.agent.upgrade() else {
+                    return;
+                };
+                let (namespace, key) = (queued.namespace, queued.key);
+                let applied = match &queued.write {
+                    LedgerWrite::Account(credential, row) => {
+                        store.save_bootstrap_accounts(std::iter::once((*credential, *row))).map(|()| "put")
+                    }
+                    write @ (LedgerWrite::PutUtxo(..)
+                    | LedgerWrite::DeleteUtxo(_)
+                    | LedgerWrite::Pots(_)
+                    | LedgerWrite::Params(_)) => store.with_transaction(|transaction| apply(transaction, write)),
+                };
+                match applied {
+                    Ok(op) if queued.write.is_unsafe() => note_unsafe_write(&agent, namespace, &key, op),
+                    Ok(op) => note_write(&agent, namespace, &key, op),
+                    Err(error) => agent.log("error", &format!("store write to {namespace}/{key} failed: {error}")),
+                }
+            }
+            while let Some(queued) = queue.pop_question() {
+                // Whoever asked may have stopped waiting; the answer is then of no use to anyone.
+                let _ = queued.answer.send(answer(ledger, &queued.question));
+            }
+        })
+    }
+
+    /// Give the queue a way to get an idle ledger thread to run the [applier](Self::applier).
+    pub fn woken_by(&self, wake: impl Fn() + Send + Sync + 'static) {
+        *self.queue.wake.lock() = Some(Box::new(wake));
+    }
+
+    /// Whether a write would be taken right now.
+    fn ready(&self) -> Result<(), String> {
+        frozen(&self.queue.agent)?;
+        if !self.queue.attached.load(Ordering::SeqCst) {
+            return Err("the ledger thread is not taking writes".to_string());
+        }
+        Ok(())
+    }
+
+    fn push(&self, namespace: &'static str, key: &str, write: LedgerWrite) -> Result<(), String> {
+        self.ready()?;
+        self.queue.pending.lock().push_back(QueuedWrite { namespace, key: key.to_string(), write });
+        self.queue.wake();
+        Ok(())
+    }
+
+    /// Have the ledger thread answer `question`, waiting for it no longer than `within`.
+    fn ask(&self, question: VolatileQuestion, within: Duration) -> Result<Json, String> {
+        if !self.queue.attached.load(Ordering::SeqCst) {
+            return Err("the ledger thread is not answering questions about its in-memory state".to_string());
+        }
+        let (answer, answered) = mpsc::sync_channel(1);
+        self.queue.questions.lock().push_back(QueuedQuestion { question, answer });
+        self.queue.wake();
+        answered.recv_timeout(within).map_err(|_| {
+            format!(
+                "the ledger thread is busy: it did not answer within {} s. It answers between two of its \
+                 requests, so not while something it is doing is held; let it finish and ask again",
+                within.as_secs_f32()
+            )
+        })?
+    }
+}
+
+impl LedgerQueue {
+    fn pop_write(&self) -> Option<QueuedWrite> {
+        self.pending.lock().pop_front()
+    }
+
+    fn pop_question(&self) -> Option<QueuedQuestion> {
+        self.questions.lock().pop_front()
+    }
+
+    fn wake(&self) {
+        if let Some(wake) = &*self.wake.lock() {
+            wake();
+        }
+    }
+}
+
+/// Apply one write inside the ledger store's own transaction, and name what was done.
+fn apply(transaction: &<RocksDB as Store>::Transaction<'_>, write: &LedgerWrite) -> Result<&'static str, StoreError> {
+    match write {
+        LedgerWrite::PutUtxo(input, output) => {
+            transaction.insert_utxo(std::iter::once((*input, (**output).clone())))?;
+            Ok("put")
+        }
+        LedgerWrite::DeleteUtxo(input) => {
+            if transaction.utxo(input)?.is_none() {
+                return Err(StoreError::Internal("no such unspent output".into()));
+            }
+            transaction.remove_utxo(std::iter::once(*input))?;
+            Ok("delete")
+        }
+        LedgerWrite::Pots(pots) => {
+            transaction.with_pots(|mut row| *row.borrow_mut() = *pots)?;
+            Ok("put")
+        }
+        LedgerWrite::Params(parameters) => {
+            transaction.set_protocol_parameters(parameters)?;
+            Ok("put")
+        }
+        LedgerWrite::Account(..) => Err(StoreError::Internal("an account is not written in a transaction".into())),
+    }
+}
+
+/// Pots given as `ledger/pots` shows them, with every pot named so that none is zeroed by omission.
+fn parse_pots(value: &Json) -> Result<Pots, String> {
+    for pot in ["treasury", "reserves", "fees", "donations"] {
+        if !value.get(pot).is_some_and(Json::is_u64) {
+            return Err(format!("needs a whole number of lovelace for `{pot}`"));
+        }
+    }
+    serde_json::from_value(value.clone()).map_err(|error| error.to_string())
+}
+
+#[derive(Clone, Copy)]
+enum LedgerFamily {
+    Tip,
+    Pots,
+    Params,
+    Utxo,
+    Stake,
+    Accounts,
+}
+
+impl LedgerFamily {
+    fn namespace(self) -> &'static str {
+        match self {
+            LedgerFamily::Tip => "ledger/tip",
+            LedgerFamily::Pots => "ledger/pots",
+            LedgerFamily::Params => "ledger/params",
+            LedgerFamily::Utxo => "ledger/utxo",
+            LedgerFamily::Stake => "ledger/stake",
+            LedgerFamily::Accounts => "ledger/accounts",
+        }
+    }
+
+    /// The name of the only entry of a namespace that holds a single value.
+    fn single(self) -> Option<&'static str> {
+        match self {
+            LedgerFamily::Tip => Some("tip"),
+            LedgerFamily::Pots => Some("pots"),
+            LedgerFamily::Params => Some("protocol_parameters"),
+            LedgerFamily::Utxo | LedgerFamily::Stake | LedgerFamily::Accounts => None,
+        }
+    }
+}
+
+/// One family of ledger state, read from disk through a read-only view opened for each request
+/// and written by the ledger thread.
+struct LedgerState {
+    config: RocksDbConfig,
+    family: LedgerFamily,
+    writes: LedgerWrites,
+}
+
+fn utxo_key(input: &TransactionInput) -> String {
+    format!("{}#{}", input.transaction_id, input.index)
+}
+
+fn parse_utxo_key(key: &str) -> Result<TransactionInput, String> {
+    let (transaction_id, index) =
+        key.rsplit_once('#').ok_or_else(|| format!("bad key `{key}`: expected <tx id>#<index>"))?;
+    Ok(TransactionInput {
+        transaction_id: transaction_id
+            .parse()
+            .map_err(|error| format!("bad transaction id in key `{key}`: {error}"))?,
+        index: index.parse().map_err(|_| format!("bad output index in key `{key}`"))?,
+    })
+}
+
+fn stake_key(credential: Option<&Credential>) -> String {
+    match credential {
+        Some(Credential::KeyHash(hash)) => format!("key-{hash}"),
+        Some(Credential::ScriptHash(hash)) => format!("script-{hash}"),
+        None => "none".to_string(),
+    }
+}
+
+/// A credential as `ledger/stake` and `ledger/accounts` name it: `key-<hash>` or `script-<hash>`.
+fn parse_credential(key: &str) -> Result<Credential, String> {
+    let bad = |error: String| format!("bad credential `{key}`: {error}");
+    let hash = |hash: &str| hash.parse().map_err(|error| bad(format!("{error}")));
+    match key.split_once('-') {
+        Some(("key", key_hash)) => Ok(Credential::KeyHash(hash(key_hash)?)),
+        Some(("script", script_hash)) => Ok(Credential::ScriptHash(hash(script_hash)?)),
+        _ => Err(bad("expected key-<hash> or script-<hash>".to_string())),
+    }
+}
+
+fn pointer_json(pointer: &CertificatePointer) -> Json {
+    json!({
+        "slot": pointer.transaction.slot.as_u64(),
+        "transaction_index": pointer.transaction.transaction_index,
+        "certificate_index": pointer.certificate_index,
+    })
+}
+
+/// A delegation as `ledger/accounts` shows it: whom it names and the certificate that made it.
+fn delegation_json<T: serde::Serialize>(delegation: Option<&(T, CertificatePointer)>) -> Result<Json, String> {
+    match delegation {
+        Some((to, at)) => Ok(json!({ "to": serde_json_of(to)?, "at": pointer_json(at) })),
+        None => Ok(Json::Null),
+    }
+}
+
+fn account_json(row: &accounts::Row) -> Result<Json, String> {
+    Ok(json!({
+        "deposit": row.deposit,
+        "rewards": row.rewards,
+        "pool": delegation_json(row.pool.as_ref())?,
+        "drep": delegation_json(row.drep.as_ref())?,
+    }))
+}
+
+/// A delegation given as `ledger/accounts` shows it. `at` may be left out, and is then the first
+/// certificate of the first transaction at slot 0.
+fn parse_delegation<T: serde::de::DeserializeOwned>(
+    value: &Json,
+    field: &str,
+) -> Result<Option<(T, CertificatePointer)>, String> {
+    let shape = || format!("`{field}` must be null or {{\"to\": .., \"at\": {{..}}}}");
+    let delegation = match value.get(field) {
+        None => return Err(format!("needs `{field}`: null for no delegation, or {{\"to\": .., \"at\": {{..}}}}")),
+        Some(Json::Null) => return Ok(None),
+        Some(Json::Object(delegation)) => delegation,
+        Some(_) => return Err(shape()),
+    };
+    if let Some(unknown) = delegation.keys().find(|name| !matches!(name.as_str(), "to" | "at")) {
+        return Err(format!("{}, not `{unknown}`", shape()));
+    }
+    let to = delegation.get("to").ok_or_else(shape)?;
+    let to = serde_json::from_value(to.clone()).map_err(|error| format!("bad `{field}.to`: {error}"))?;
+    let at = match delegation.get("at") {
+        None => CertificatePointer::default(),
+        Some(at) => {
+            let number = |name: &str| {
+                at.get(name).and_then(Json::as_u64).ok_or(format!("`{field}.at` needs a whole number `{name}`"))
+            };
+            CertificatePointer {
+                transaction: TransactionPointer {
+                    slot: Slot::from(number("slot")?),
+                    transaction_index: number("transaction_index")? as usize,
+                },
+                certificate_index: number("certificate_index")? as usize,
+            }
+        }
+    };
+    Ok(Some((to, at)))
+}
+
+/// An account given as `ledger/accounts` shows it, with every field named so that none is zeroed
+/// or dropped by omission.
+fn parse_account(value: &Json) -> Result<accounts::Row, String> {
+    let fields = value.as_object().ok_or("an account is an object")?;
+    if let Some(unknown) =
+        fields.keys().find(|name| !matches!(name.as_str(), "deposit" | "rewards" | "pool" | "drep" | "unsafe"))
+    {
+        return Err(format!("an account has `deposit`, `rewards`, `pool` and `drep`, not `{unknown}`"));
+    }
+    let lovelace = |field: &str| {
+        value.get(field).and_then(Json::as_u64).ok_or(format!("needs a whole number of lovelace for `{field}`"))
+    };
+    Ok(accounts::Row {
+        deposit: lovelace("deposit")?,
+        rewards: lovelace("rewards")?,
+        pool: parse_delegation(value, "pool")?,
+        drep: parse_delegation(value, "drep")?,
+    })
+}
+
+const STAKE_IS_DERIVED: &str = "ledger/stake is read-only: it is not stored but summed from the unspent outputs. \
+                                Change the outputs it sums under ledger/utxo, or an account's deposit, rewards \
+                                and delegation under ledger/accounts";
+
+impl LedgerState {
+    fn open(&self) -> Result<ReadOnlyRocksDB, String> {
+        ReadOnlyRocksDB::new(&self.config).map_err(|error| format!("cannot open the ledger store read-only: {error}"))
+    }
+
+    fn single_value(&self, db: &ReadOnlyRocksDB) -> Result<Json, String> {
+        match self.family {
+            LedgerFamily::Tip => {
+                let tip = db.tip().map_err(|error| error.to_string())?;
+                Ok(json!({ "slot": tip.slot_or_default().as_u64(), "hash": tip.hash().to_string() }))
+            }
+            LedgerFamily::Pots => serde_json_of(&db.pots().map_err(|error| error.to_string())?),
+            LedgerFamily::Params => Ok(cbor_json(&db.protocol_parameters().map_err(|error| error.to_string())?)),
+            LedgerFamily::Utxo | LedgerFamily::Stake | LedgerFamily::Accounts => Ok(Json::Null),
+        }
+    }
+
+    /// Lovelace held in unspent outputs, summed per stake credential. Outputs whose address has
+    /// no stake credential are summed under `none`.
+    fn stake(db: &ReadOnlyRocksDB) -> Result<BTreeMap<String, u64>, String> {
+        let mut stake = BTreeMap::<String, u64>::new();
+        for entry in db.iter_stake_distribution().map_err(|error| error.to_string())? {
+            let lovelace = stake.entry(stake_key(entry.credential.as_ref())).or_default();
+            *lovelace = lovelace.saturating_add(entry.lovelace);
+        }
+        Ok(stake)
+    }
+}
+
+impl StateProvider for LedgerState {
+    fn list(&self, prefix: &str, after: Option<&str>, limit: usize) -> Result<Vec<Json>, String> {
+        let db = self.open()?;
+        match self.family {
+            LedgerFamily::Tip | LedgerFamily::Pots | LedgerFamily::Params => {
+                let name = self.family.single().unwrap_or_default();
+                Ok(page(vec![(name, self.single_value(&db)?)], prefix, after, limit))
+            }
+            LedgerFamily::Utxo => {
+                let after = after.map(parse_utxo_key).transpose()?;
+                Ok(db
+                    .iter_utxos()
+                    .map_err(|error| error.to_string())?
+                    .skip_while(|(input, _)| after.as_ref().is_some_and(|after| input <= after))
+                    .map(|(input, output)| (utxo_key(&input), output))
+                    .filter(|(key, _)| key.starts_with(prefix))
+                    .take(limit)
+                    .map(|(key, output)| entry(key, cbor_json(&output)))
+                    .collect())
+            }
+            LedgerFamily::Stake => Ok(Self::stake(&db)?
+                .into_iter()
+                .filter(|(key, _)| key.starts_with(prefix) && after.is_none_or(|after| key.as_str() > after))
+                .take(limit)
+                .map(|(key, lovelace)| entry(key, json!({ "lovelace": lovelace })))
+                .collect()),
+            LedgerFamily::Accounts => {
+                let mut rows = db
+                    .iter_accounts()
+                    .map_err(|error| error.to_string())?
+                    .map(|(credential, row)| (stake_key(Some(&credential)), row));
+                // Accounts come in the order the store keeps them in, so the page starts behind
+                // the entry named `after` wherever that is.
+                if let Some(after) = after
+                    && !rows.by_ref().any(|(key, _)| key == after)
+                {
+                    return Err(format!("no account `{after}` to list after"));
+                }
+                rows.filter(|(key, _)| key.starts_with(prefix))
+                    .take(limit)
+                    .map(|(key, row)| Ok(entry(key, account_json(&row)?)))
+                    .collect()
+            }
+        }
+    }
+
+    fn get(&self, key: &str) -> Result<Option<Json>, String> {
+        let db = self.open()?;
+        match self.family {
+            LedgerFamily::Tip | LedgerFamily::Pots | LedgerFamily::Params => {
+                if key.is_empty() || Some(key) == self.family.single() {
+                    self.single_value(&db).map(Some)
+                } else {
+                    Ok(None)
+                }
+            }
+            LedgerFamily::Utxo => {
+                let output = db.utxo(&parse_utxo_key(key)?).map_err(|error| error.to_string())?;
+                Ok(output.map(|output| cbor_json(&output)))
+            }
+            LedgerFamily::Stake => Ok(Self::stake(&db)?.get(key).map(|lovelace| json!({ "lovelace": lovelace }))),
+            LedgerFamily::Accounts => {
+                let row = db.account(&parse_credential(key)?).map_err(|error| error.to_string())?;
+                row.map(|row| account_json(&row)).transpose()
+            }
+        }
+    }
+
+    fn put(&self, key: &str, value: &Json) -> Result<(), String> {
+        let namespace = self.family.namespace();
+        let single = |key: &str| {
+            if key.is_empty() || Some(key) == self.family.single() {
+                Ok(self.family.single().unwrap_or_default())
+            } else {
+                Err(format!("{namespace} has no `{key}`"))
+            }
+        };
+        match self.family {
+            LedgerFamily::Tip => return read_only(namespace),
+            LedgerFamily::Stake => return Err(STAKE_IS_DERIVED.to_string()),
+            LedgerFamily::Pots | LedgerFamily::Params | LedgerFamily::Utxo | LedgerFamily::Accounts => {}
+        }
+        self.writes.ready()?;
+        let (key, write) = match self.family {
+            LedgerFamily::Tip | LedgerFamily::Stake => return read_only(namespace),
+            LedgerFamily::Accounts => {
+                owned_up_to(namespace, value)?;
+                (key, LedgerWrite::Account(parse_credential(key)?, parse_account(value)?))
+            }
+            LedgerFamily::Pots => (single(key)?, LedgerWrite::Pots(parse_pots(value)?)),
+            LedgerFamily::Params => {
+                (single(key)?, LedgerWrite::Params(Box::new(decoded("set of protocol parameters", value)?)))
+            }
+            LedgerFamily::Utxo => {
+                (key, LedgerWrite::PutUtxo(parse_utxo_key(key)?, Box::new(decoded("transaction output", value)?)))
+            }
+        };
+        self.writes.push(namespace, key, write)
+    }
+
+    fn delete(&self, key: &str) -> Result<(), String> {
+        let namespace = self.family.namespace();
+        match self.family {
+            LedgerFamily::Tip => read_only(namespace),
+            LedgerFamily::Stake => Err(STAKE_IS_DERIVED.to_string()),
+            LedgerFamily::Accounts => Err(format!(
+                "{namespace} takes no delete: a delete carries no value, so it cannot say `\"unsafe\": true`. \
+                 Put the account with no deposit, no rewards and no delegation instead"
+            )),
+            LedgerFamily::Pots | LedgerFamily::Params => {
+                Err(format!("{namespace} holds one value, which can be replaced but not deleted"))
+            }
+            LedgerFamily::Utxo => {
+                self.writes.ready()?;
+                self.writes.push(namespace, key, LedgerWrite::DeleteUtxo(parse_utxo_key(key)?))
+            }
+        }
+    }
+
+    fn receipt(&self, _key: &str) -> Json {
+        let mut receipt = json!({
+            "queued": true,
+            "applied": "by the ledger thread before its next request; a `store_write` item reports it, a log event a failure",
+            "scope": "the ledger as stored; what the node holds in memory for the last blocks is not changed",
+        });
+        if let LedgerFamily::Accounts = self.family {
+            receipt["unsafe"] = json!(true);
+            receipt["warning"] = json!(UNSAFE_WARNING);
+        }
+        receipt
+    }
+}
+
+const VOLATILE_NAMESPACE: &str = "ledger/volatile";
+
+/// How long a question about the ledger's in-memory state waits for the ledger thread.
+const LEDGER_THREAD_PATIENCE: Duration = Duration::from_secs(5);
+
+const VOLATILE_IS_READ_ONLY: &str = "ledger/volatile is read-only: the ledger only rolls its in-memory blocks back as the first half of a \
+     switch to a fork, which replays at least as many blocks as it dropped. Dropping blocks without replaying \
+     any would leave the block validation stage, which keeps the ledger's tip itself, and the chain store \
+     ahead of the ledger; the next block would then be applied on top of a block that is not its parent, \
+     because the ledger does not check a block's parent. Let the node switch forks to roll these blocks back";
+
+/// The blocks the ledger holds in memory past its stored tip, read by the ledger thread itself
+/// between two of its requests.
+struct VolatileState {
+    writes: LedgerWrites,
+    answer_within: Duration,
+}
+
+/// A pool as the stores name it: the hash of its cold key in hexadecimal, the form
+/// `ledger/accounts` takes in `pool.to`.
+fn pool_key(pool: &PoolId) -> String {
+    hex::encode(pool)
+}
+
+/// What one in-memory block changed, in numbers.
+fn volatile_summary(block: &AnchoredVolatileFragment) -> Json {
+    let (point, issuer) = &block.anchor;
+    let changes = &block.fragment;
+    json!({
+        "point": chain_point(point),
+        "issuer": pool_key(issuer),
+        "utxo": { "produced": changes.utxo.produced.len(), "consumed": changes.utxo.consumed.len() },
+        "pools": { "registered": changes.pools.registered.len(), "retiring": changes.pools.unregistered.len() },
+        "accounts": {
+            "changed": changes.accounts.registered.len(),
+            "unregistered": changes.accounts.unregistered.len(),
+        },
+        "dreps": {
+            "changed": changes.dreps.registered.len(),
+            "unregistered": changes.dreps.unregistered.len() + changes.dreps_deregistrations.len(),
+        },
+        "committee": changes.committee.registered.len(),
+        "withdrawals": changes.withdrawals.len(),
+        "proposals": changes.proposals.len(),
+        "votes": changes.votes.produced.len(),
+        "fees": changes.fees,
+        "donations": changes.donations,
+    })
+}
+
+/// What one in-memory block changed, naming each thing it touched.
+fn volatile_detail(block: &AnchoredVolatileFragment) -> Json {
+    let changes = &block.fragment;
+    let credentials = |credentials: &mut dyn Iterator<Item = &Credential>| -> Vec<String> {
+        credentials.map(|credential| stake_key(Some(credential))).collect()
+    };
+    let mut summary = volatile_summary(block);
+    summary["detail"] = json!({
+        "utxo": {
+            "produced": changes
+                .utxo
+                .produced
+                .iter()
+                .map(|(input, output)| json!({ "key": utxo_key(input), "output": cbor_json(&**output) }))
+                .collect::<Vec<_>>(),
+            "consumed": changes.utxo.consumed.iter().map(utxo_key).collect::<Vec<_>>(),
+        },
+        "pools": {
+            "registered": changes.pools.registered.keys().map(pool_key).collect::<Vec<_>>(),
+            "retiring": changes
+                .pools
+                .unregistered
+                .iter()
+                .map(|(pool, epoch)| json!({ "pool": pool_key(pool), "epoch": epoch.as_u64() }))
+                .collect::<Vec<_>>(),
+        },
+        "accounts": {
+            "changed": credentials(&mut changes.accounts.registered.keys()),
+            "unregistered": credentials(&mut changes.accounts.unregistered.iter()),
+        },
+        "dreps": {
+            "changed": credentials(&mut changes.dreps.registered.keys()),
+            "unregistered": credentials(
+                &mut changes.dreps.unregistered.iter().chain(changes.dreps_deregistrations.keys()),
+            ),
+        },
+        "committee": credentials(&mut changes.committee.registered.keys()),
+        "withdrawals": credentials(&mut changes.withdrawals.iter()),
+        "proposals": changes.proposals.keys().map(ToString::to_string).collect::<Vec<_>>(),
+    });
+    summary
+}
+
+/// Answer a question about the ledger's in-memory blocks; runs on the ledger thread.
+fn answer(ledger: &dyn LedgerView, question: &VolatileQuestion) -> Result<Json, String> {
+    match question {
+        VolatileQuestion::List { prefix, after, limit } => Ok(Json::Array(
+            ledger
+                .volatile_blocks()
+                .map(|block| (chain_key(&block.point()), block))
+                .filter(|(key, _)| key.starts_with(prefix) && after.as_ref().is_none_or(|after| key > after))
+                .take(*limit)
+                .map(|(key, block)| entry(key, volatile_summary(block)))
+                .collect(),
+        )),
+        VolatileQuestion::Get(key) => {
+            let (slot, hash) = parse_chain_key(key)?;
+            Ok(ledger
+                .volatile_blocks()
+                .find(|block| {
+                    let point = block.point();
+                    point.hash() == hash && slot.is_none_or(|slot| slot == point.slot_or_default())
+                })
+                .map_or(Json::Null, volatile_detail))
+        }
+    }
+}
+
+impl StateProvider for VolatileState {
+    fn list(&self, prefix: &str, after: Option<&str>, limit: usize) -> Result<Vec<Json>, String> {
+        let question = VolatileQuestion::List { prefix: prefix.to_string(), after: after.map(str::to_string), limit };
+        Ok(self.writes.ask(question, self.answer_within)?.as_array().cloned().unwrap_or_default())
+    }
+
+    fn get(&self, key: &str) -> Result<Option<Json>, String> {
+        let block = self.writes.ask(VolatileQuestion::Get(key.to_string()), self.answer_within)?;
+        Ok((!block.is_null()).then_some(block))
+    }
+
+    fn put(&self, _key: &str, _value: &Json) -> Result<(), String> {
+        Err(VOLATILE_IS_READ_ONLY.to_string())
+    }
+
+    fn delete(&self, _key: &str) -> Result<(), String> {
+        Err(VOLATILE_IS_READ_ONLY.to_string())
+    }
+}
