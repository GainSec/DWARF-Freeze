+//! Offers decoded mini-protocol traffic to the freeze agent, when one is installed.
+
+use std::{collections::BTreeMap, sync::LazyLock};
+
+use amaru_freeze::{
+    Draft,
+    wire::{BytesItem, BytesVerdict, gate_bytes},
+};
