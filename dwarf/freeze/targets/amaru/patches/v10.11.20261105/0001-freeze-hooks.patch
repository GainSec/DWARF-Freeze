+#![allow(clippy::unwrap_used, clippy::wildcard_enum_match_arm)]
+// Test-fixture construction is intentionally fail-fast, and the fallback match
+// arms keep protocol failures readable when a decoded message is unexpected.
+
+use std::{fs, path::Path};
+
+use amaru_kernel::{
+    BlockHeight, Bytes, Ed25519Signature, EraHistory, EraName, Hash, Hasher, Header, HeaderBody, IsHeader,
+    KesSignature, NetworkPoint, OperationalCert, Point, ProtocolVersion, Slot, TransactionBody, VerificationKey,
+    VrfCert,
+    cardano::{
+        fixed_bytes::FixedBytes,
+        network_block::{NetworkBlock, make_block_with_header},
+    },
+    ed25519, from_cbor_no_leftovers,
+    size::POOL_COLD_KEY,
+    to_cbor,
+};
+use amaru_ouroboros::{kes, vrf};
+use amaru_protocols::{
+    blockfetch, chainsync,
+    resign::{ChainSyncDirection, Coordinator, Resigner},
+};
+use kes_summed_ed25519::{kes::Sum6Kes, traits::KesSk};
+use serde_json::json;
+use tempfile::TempDir;
+
+struct Fixture {
+    directory: TempDir,
+    body: HeaderBody,
+    kes_public: kes::PublicKey,
+}
+
+#[test]
+fn outbound_blockfetch_repair_is_mux_bound_for_two_peers_and_multi_block_ranges() {
+    let (_fixture, coordinator, blocks, signed_headers) = linear_range_mappings().unwrap();
+    let edited_points =
+        signed_headers.iter().map(|header| NetworkPoint::Specific(header.slot(), header.hash())).collect::<Vec<_>>();
+    let request_a = coordinator.responder_blockfetch_request("mux-a", edited_points[0], edited_points[2]);
+    let request_b = coordinator.responder_blockfetch_request("mux-b", edited_points[0], edited_points[2]);
+    let wrong_mux = coordinator
+        .rewrite_responder_block("mux-b", &request_a, blocks[1].clone())
+        .expect_err("a responder lease must not move between muxes");
+    assert!(wrong_mux.to_string().contains("mux identity"), "{wrong_mux}");
+    let repaired_a = coordinator.rewrite_responder_block("mux-a", &request_a, blocks[1].clone()).unwrap();
+    let repaired_b = coordinator.rewrite_responder_block("mux-b", &request_b, blocks[1].clone()).unwrap();
+    assert_eq!(repaired_a.decode_header().unwrap(), signed_headers[1]);
+    assert_eq!(repaired_b.decode_header().unwrap(), signed_headers[1]);
+}
+
+#[test]
+fn outbound_blockfetch_repair_rejects_duplicate_finished_and_restarted_requests() {
+    let (_fixture, coordinator, blocks, signed_headers) = linear_range_mappings().unwrap();
+    let edited_points =
+        signed_headers.iter().map(|header| NetworkPoint::Specific(header.slot(), header.hash())).collect::<Vec<_>>();
+    let duplicate = coordinator.responder_blockfetch_request("mux-a", edited_points[0], edited_points[2]);
+    coordinator.rewrite_responder_block("mux-a", &duplicate, blocks[1].clone()).unwrap();
+    let duplicate_error = coordinator
+        .rewrite_responder_block("mux-a", &duplicate, blocks[1].clone())
+        .expect_err("a duplicate block in one batch must fail closed");
+    assert!(duplicate_error.to_string().contains("already consumed"), "{duplicate_error}");
+    let finished = coordinator.responder_blockfetch_request("mux-a", edited_points[0], edited_points[2]);
+    coordinator.finish_blockfetch_request(&finished);
+    let finished_error = coordinator
+        .rewrite_responder_block("mux-a", &finished, blocks[1].clone())
+        .expect_err("BatchDone or NoBlocks must retire the request");
+    assert!(finished_error.to_string().contains("no longer active"), "{finished_error}");
+    let restarted = coordinator.responder_blockfetch_request("mux-a", edited_points[0], edited_points[2]);
+    coordinator.disconnect("mux-a");
+    let restart_error = coordinator
+        .rewrite_responder_block("mux-a", &restarted, blocks[1].clone())
+        .expect_err("disconnect must invalidate an old responder request");
+    assert!(restart_error.to_string().contains("no longer active"), "{restart_error}");
+}
+
+#[test]
+fn outbound_chainsync_repair_is_direction_scoped_and_cleared_on_disconnect() {
+    let fixture = Fixture::new(0);
+    let coordinator = Coordinator::new();
+    let resigner = Resigner::new(true, Some(fixture.directory.path().into()));
+    let original_header = fixture.header(&fixture.body);
+    let original_decoded: Header = from_cbor_no_leftovers(&original_header).unwrap();
+    let original = chain_message(&original_header, original_decoded.hash(), &fixture.body);
+    let mut edited_body = fixture.body.clone();
+    edited_body.block_body_size += 1;
+    let edited = chain_message(&fixture.header(&edited_body), original_decoded.hash(), &fixture.body);
+    let repaired: chainsync::Message = from_cbor_no_leftovers(
+        &coordinator
+            .chain_sync(&resigner, ChainSyncDirection::Outbound, "mux-a", "peer-a", &original, &edited)
+            .unwrap(),
+    )
+    .unwrap();
+    let repaired_header = match repaired {
+        chainsync::Message::RollForward(content, _) => from_cbor_no_leftovers::<Header>(&content.cbor).unwrap(),
+        other => panic!("unexpected message: {other:?}"),
+    };
+    let signature = kes::Signature::try_from(repaired_header.signature().as_slice()).unwrap();
+    signature.verify(0.into(), &fixture.kes_public, &to_cbor(repaired_header.body())).unwrap();
+
