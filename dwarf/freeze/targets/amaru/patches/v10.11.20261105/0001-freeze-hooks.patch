+#[test]
+fn coordinator_rewrites_and_resigns_only_descendants_of_an_edited_header() {
+    let fixture = Fixture::new(0);
+    let coordinator = Coordinator::new();
+    let resigner = Resigner::new(true, Some(fixture.directory.path().into()));
+
+    let original_header = fixture.header(&fixture.body);
+    let original_decoded: Header = from_cbor_no_leftovers(&original_header).unwrap();
+    let original = chain_message(&original_header, original_decoded.hash(), &fixture.body);
+    let mut edited_body = fixture.body.clone();
+    edited_body.block_body_size += 1;
+    let edited = chain_message(&fixture.header(&edited_body), original_decoded.hash(), &fixture.body);
+    let signed: chainsync::Message = from_cbor_no_leftovers(
+        &coordinator.chain_sync(&resigner, ChainSyncDirection::Inbound, "chain-a", "peer", &original, &edited).unwrap(),
+    )
+    .unwrap();
+    let signed_header = match signed {
+        chainsync::Message::RollForward(content, _) => from_cbor_no_leftovers::<Header>(&content.cbor).unwrap(),
+        other => panic!("unexpected message: {other:?}"),
+    };
+
+    let mut descendant_body = fixture.body.clone();
+    descendant_body.block_number += 1;
+    descendant_body.slot += 1;
+    descendant_body.prev_hash = Some(original_decoded.hash());
+    let descendant_header = fixture.header(&descendant_body);
+    let descendant_decoded: Header = from_cbor_no_leftovers(&descendant_header).unwrap();
+    let descendant = chain_message(&descendant_header, descendant_decoded.hash(), &descendant_body);
+    let rewritten = coordinator
+        .chain_sync(&resigner, ChainSyncDirection::Inbound, "chain-a", "peer", &descendant, &descendant)
+        .unwrap();
+    let rewritten: chainsync::Message = from_cbor_no_leftovers(&rewritten).unwrap();
+    let rewritten_header = match rewritten {
+        chainsync::Message::RollForward(content, tip) => {
+            let header: Header = from_cbor_no_leftovers(&content.cbor).unwrap();
+            assert_eq!(tip.hash(), header.hash());
+            header
+        }
+        other => panic!("unexpected message: {other:?}"),
+    };
+    assert_eq!(rewritten_header.body().prev_hash, Some(signed_header.hash()));
+    assert_ne!(rewritten_header.hash(), descendant_decoded.hash());
+    let signature = kes::Signature::try_from(rewritten_header.signature().as_slice()).unwrap();
+    signature.verify(0.into(), &fixture.kes_public, &to_cbor(rewritten_header.body())).unwrap();
+    assert_eq!(coordinator.pending("peer"), 2);
+
+    let unrelated = chain_message(&original_header, original_decoded.hash(), &fixture.body);
+    assert_eq!(
+        coordinator
+            .chain_sync(&resigner, ChainSyncDirection::Inbound, "chain-b", "peer", &unrelated, &unrelated)
+            .unwrap(),
+        unrelated,
+        "a reconnect/new ChainSync stream must not inherit ancestry rewrites from the old stream"
+    );
+
+    let edited_point = NetworkPoint::Specific(signed_header.slot(), signed_header.hash());
+    let request =
+        to_cbor(&blockfetch::Message::from(blockfetch::RequestRange { from: edited_point, through: edited_point }));
+    assert_ne!(
+        coordinator.blockfetch_out("peer", &request, &request).unwrap(),
+        request,
+        "BlockFetch on a distinct mux still shares the peer's edited-to-original mapping"
+    );
+}
