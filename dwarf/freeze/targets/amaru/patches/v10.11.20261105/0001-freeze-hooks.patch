+//! Offers every byte read from or written to a peer to the freeze agent.
+
+use std::{
+    collections::BTreeMap, future::Future, net::SocketAddr, num::NonZeroUsize, pin::Pin, sync::Arc, time::Duration,
+};
+
+use amaru_freeze::wire::{BytesItem, BytesVerdict, gate_bytes};
+use amaru_kernel::{NonEmptyBytes, Peer};
+use amaru_ouroboros::{ConnectionId, ConnectionProvider};
+use parking_lot::Mutex;
+
+type BoxFuture<T> = Pin<Box<dyn Future<Output = T> + Send + 'static>>;
+
+/// A [`ConnectionProvider`] that shows its traffic to the freeze agent before passing it on.
+pub struct FreezeConnections {
+    inner: Arc<dyn ConnectionProvider>,
+    peers: Arc<Mutex<BTreeMap<ConnectionId, Peer>>>,
+}
+
+impl FreezeConnections {
+    /// Wrap `inner` if this process is being debugged; otherwise return it unchanged.
+    pub fn wrap(inner: Arc<dyn ConnectionProvider>) -> Arc<dyn ConnectionProvider> {
+        if amaru_freeze::agent().is_none() {
+            return inner;
+        }
+        Arc::new(Self { inner, peers: Arc::default() })
+    }
+}
+
+fn peer_name(peers: &Mutex<BTreeMap<ConnectionId, Peer>>, conn: ConnectionId) -> String {
+    match peers.lock().get(&conn) {
+        Some(peer) => format!("peer:{peer}"),
+        None => format!("peer:connection-{conn}"),
+    }
+}
+
+impl ConnectionProvider for FreezeConnections {
+    fn listen(&self, addr: SocketAddr) -> BoxFuture<std::io::Result<SocketAddr>> {
+        self.inner.listen(addr)
+    }
+
+    fn accept(&self, listener_addr: SocketAddr) -> BoxFuture<std::io::Result<(Peer, ConnectionId)>> {
+        let (accepting, peers) = (self.inner.accept(listener_addr), self.peers.clone());
+        Box::pin(async move {
+            let (peer, conn) = accepting.await?;
+            peers.lock().insert(conn, peer);
+            Ok((peer, conn))
+        })
+    }
+
+    fn connect(&self, peer: Peer, timeout: Duration) -> BoxFuture<std::io::Result<ConnectionId>> {
+        let (connecting, peers) = (self.inner.connect(peer, timeout), self.peers.clone());
+        Box::pin(async move {
+            let conn = connecting.await?;
+            peers.lock().insert(conn, peer);
+            Ok(conn)
+        })
+    }
+
+    fn send(&self, conn: ConnectionId, data: NonEmptyBytes) -> BoxFuture<std::io::Result<()>> {
+        let (inner, peers) = (self.inner.clone(), self.peers.clone());
+        Box::pin(async move {
+            let Some(agent) = amaru_freeze::agent() else {
+                return inner.send(conn, data).await;
+            };
+            let item = BytesItem {
+                kind: "wire_out",
+                from: "node".to_string(),
+                to: peer_name(&peers, conn),
+                type_name: String::new(),
+                label: "bytes".to_string(),
+                cold_spots: vec!["wire-out"],
+                bytes: &data[..],
+                is_cbor: false,
+                parent: 0,
+                cause: 0,
+            };
+            match gate_bytes(agent, item).await.1 {
+                BytesVerdict::Forward => inner.send(conn, data).await,
+                BytesVerdict::Drop => Ok(()),
+                BytesVerdict::Replace(bytes) | BytesVerdict::ReplaceStale(bytes) => {
+                    match NonEmptyBytes::from_slice(&bytes) {
+                        Ok(replacement) => inner.send(conn, replacement).await,
+                        Err(_) => Ok(()),
+                    }
+                }
+            }
+        })
+    }
+
+    fn recv(&self, conn: ConnectionId, bytes: NonZeroUsize) -> BoxFuture<std::io::Result<NonEmptyBytes>> {
+        let (inner, peers) = (self.inner.clone(), self.peers.clone());
+        Box::pin(async move {
+            loop {
+                let data = inner.recv(conn, bytes).await?;
+                let Some(agent) = amaru_freeze::agent() else {
+                    return Ok(data);
+                };
+                let item = BytesItem {
+                    kind: "wire_in",
+                    from: peer_name(&peers, conn),
+                    to: "node".to_string(),
+                    type_name: String::new(),
+                    label: "bytes".to_string(),
+                    cold_spots: vec!["wire-in"],
+                    bytes: &data[..],
+                    is_cbor: false,
+                    parent: 0,
+                    cause: 0,
+                };
+                match gate_bytes(agent, item).await.1 {
+                    BytesVerdict::Forward => return Ok(data),
+                    // Dropped bytes never arrived: wait for the next ones.
+                    BytesVerdict::Drop => continue,
+                    BytesVerdict::Replace(replacement) | BytesVerdict::ReplaceStale(replacement) => {
+                        if let Ok(replacement) = NonEmptyBytes::from_slice(&replacement) {
+                            return Ok(replacement);
+                        }
+                    }
+                }
+            }
+        })
+    }
+
+    fn close(&self, conn: ConnectionId) -> BoxFuture<std::io::Result<()>> {
+        let (closing, peers) = (self.inner.close(conn), self.peers.clone());
+        Box::pin(async move {
+            peers.lock().remove(&conn);
+            closing.await
+        })
+    }
+
+    fn local_addr(&self, conn: ConnectionId) -> BoxFuture<std::io::Result<SocketAddr>> {
+        self.inner.local_addr(conn)
+    }
+}
